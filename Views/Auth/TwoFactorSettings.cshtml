@model FinSight.Models.ViewModels.TwoFactorSettingsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Two-Factor Authentication Settings";
}

<style>
    .tfa-container {
        max-width: 680px;
        margin: 0 auto;
    }

    .tfa-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .tfa-header-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(5,130,142,0.12), rgba(5,130,142,0.05));
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tfa-header-icon i {
        font-size: 1.5rem;
        color: #05828e;
    }

    .tfa-header-text h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #080b11;
        margin: 0;
    }

    .tfa-header-text p {
        font-size: 0.9rem;
        color: #9ba8b8;
        margin: 0.25rem 0 0;
    }

    /* Status Card */
    .tfa-status-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(8,11,17,0.06);
        border: 1px solid rgba(155,168,184,0.15);
        margin-bottom: 1.5rem;
    }

    .tfa-status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .tfa-status-info {
        flex: 1;
    }

    .tfa-status-info h4 {
        font-size: 1rem;
        font-weight: 600;
        color: #080b11;
        margin: 0 0 0.35rem;
    }

    .tfa-status-info p {
        font-size: 0.85rem;
        color: #9ba8b8;
        margin: 0;
        line-height: 1.5;
    }

    /* Toggle Switch */
    .tfa-toggle {
        position: relative;
        width: 52px;
        height: 28px;
        flex-shrink: 0;
    }

    .tfa-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .tfa-toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #9ba8b8;
        border-radius: 14px;
        transition: all 0.3s ease;
    }

    .tfa-toggle-slider::before {
        content: '';
        position: absolute;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #ffffff;
        top: 3px;
        left: 3px;
        transition: all 0.3s ease;
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    .tfa-toggle input:checked + .tfa-toggle-slider {
        background: #05828e;
    }

    .tfa-toggle input:checked + .tfa-toggle-slider::before {
        transform: translateX(24px);
    }

    .tfa-toggle input:disabled + .tfa-toggle-slider {
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* Status Badge */
    .tfa-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.85rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .tfa-badge-active {
        background: rgba(5,130,142,0.1);
        color: #05828e;
    }

    .tfa-badge-inactive {
        background: rgba(211,47,47,0.08);
        color: #c62828;
    }

    .tfa-badge-mandatory {
        background: rgba(255,152,0,0.1);
        color: #e65100;
    }

    /* Info Card */
    .tfa-info-card {
        background: rgba(5,130,142,0.04);
        border: 1px solid rgba(5,130,142,0.12);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-top: 1.5rem;
    }

    .tfa-info-card h5 {
        font-size: 0.9rem;
        font-weight: 600;
        color: #05828e;
        margin: 0 0 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tfa-info-card ul {
        margin: 0;
        padding-left: 1.25rem;
    }

    .tfa-info-card li {
        font-size: 0.82rem;
        color: #162229;
        margin-bottom: 0.35rem;
        line-height: 1.5;
    }

    /* Status Message */
    .tfa-alert {
        border-radius: 12px;
        padding: 0.85rem 1.25rem;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        animation: slideIn 0.3s ease-out;
    }

    .tfa-alert-success {
        background: rgba(5,130,142,0.08);
        border: 1px solid rgba(5,130,142,0.2);
        color: #05828e;
    }

    .tfa-alert-warning {
        background: rgba(255,152,0,0.06);
        border: 1px solid rgba(255,152,0,0.15);
        color: #e65100;
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="tfa-container">
    <!-- Header -->
    <div class="tfa-header">
        <div class="tfa-header-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="tfa-header-text">
            <h2>Two-Factor Authentication</h2>
            <p>Add an extra layer of security to your account</p>
        </div>
    </div>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="tfa-alert @(Model.StatusMessage.Contains("cannot") || Model.StatusMessage.Contains("mandatory") ? "tfa-alert-warning" : "tfa-alert-success")">
            <i class="bi @(Model.StatusMessage.Contains("cannot") || Model.StatusMessage.Contains("mandatory") ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
            @Model.StatusMessage
        </div>
    }

    <!-- Main Status Card -->
    <div class="tfa-status-card">
        <div class="tfa-status-row">
            <div class="tfa-status-info">
                <h4>
                    Email Verification
                    @if (Model.IsTwoFactorEnabled)
                    {
                        <span class="tfa-badge tfa-badge-active ms-2"><i class="bi bi-check-circle-fill"></i> Active</span>
                    }
                    else
                    {
                        <span class="tfa-badge tfa-badge-inactive ms-2"><i class="bi bi-x-circle-fill"></i> Disabled</span>
                    }
                </h4>
                <p>
                    When enabled, you'll receive a 6-digit verification code via email each time you log in.
                    This helps protect your account even if your password is compromised.
                </p>

                @if (Model.IsMandatory)
                {
                    <div class="mt-2">
                        <span class="tfa-badge tfa-badge-mandatory">
                            <i class="bi bi-lock-fill"></i> Mandatory for @Model.RoleName
                        </span>
                    </div>
                }
            </div>

            <!-- Toggle -->
            <form asp-action="ToggleTwoFactor" asp-controller="Auth" method="post" id="toggleForm">
                @Html.AntiForgeryToken()
                <label class="tfa-toggle">
                    <input type="checkbox"
                           @(Model.IsTwoFactorEnabled ? "checked" : "")
                           @(Model.IsMandatory ? "disabled" : "")
                           onchange="document.getElementById('toggleForm').submit();" />
                    <span class="tfa-toggle-slider"></span>
                </label>
            </form>
        </div>
    </div>

    <!-- How It Works -->
    <div class="tfa-info-card">
        <h5><i class="bi bi-info-circle-fill"></i> How it works</h5>
        <ul>
            <li>After entering your email and password, a <strong>6-digit verification code</strong> will be sent to your registered email.</li>
            <li>Enter the code to complete your login. Codes expire after <strong>5 minutes</strong>.</li>
            <li>If you enter the wrong code too many times, verification will be <strong>temporarily locked</strong> for security.</li>
            <li>Two-Factor Authentication is <strong>mandatory</strong> for Super Admin, Admin, and Finance Manager roles.</li>
        </ul>
    </div>
</div>
