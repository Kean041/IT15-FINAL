@model FinSight.Models.ViewModels.LoginViewModel
@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Login";
}

<div class="auth-title">Sign in</div>
<div class="auth-subtitle">Welcome back! Please enter your details.</div>

<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
    </div>
}

<!-- Error Message -->
@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger py-2 small mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
    </div>
}

<form asp-action="Login" asp-controller="Auth" method="post">
    @Html.AntiForgeryToken()

    <!-- Email Field -->
    <div class="mb-4">
        <label asp-for="Email" class="form-label">Email Address</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" />
        </div>
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <!-- Password Field -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
            <span class="input-group-text password-toggle" onclick="togglePassword('Password', this)">
                <i class="bi bi-eye-slash"></i>
            </span>
        </div>
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <!-- Remember Me & Forgot Password -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="rememberMeCheck" asp-for="RememberMe" />
            <label class="form-check-label" for="rememberMeCheck">Remember me</label>
        </div>
        <a href="#" class="small">Forgot Password?</a>
    </div>

    <!-- Login Button -->
    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
        Login Securely <i class="bi bi-arrow-right ms-2"></i>
    </button>
    
    <button type="button" class="btn btn-outline-secondary w-100 py-2 mb-4 d-none">
        <i class="bi bi-google me-2"></i> Sign in with Google
    </button>

    <!-- Register Link -->
    <div class="text-center small" style="color: var(--text-muted);">
        Don't have an account?
        <a asp-controller="Auth" asp-action="Register" class="fw-bold ms-1" style="color: var(--primary);">Register</a>
    </div>
</form>
