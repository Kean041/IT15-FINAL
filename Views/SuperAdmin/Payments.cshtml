@model FinSight.Models.ViewModels.SuperAdminPaymentViewModel

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Global Payments";
}

<style>
:root {
    --tq: #05828e; --tq-dark: #047078; --tq-light: rgba(5,130,142,0.08);
    --tq-glow: rgba(5,130,142,0.18); --navy: #162229;
    --danger: #E26D5C; --success: #10b981; --warning: #f59e0b;
}
.bg-offwhite { background-color: #e7eaef; }
.text-turquoise { color: var(--tq) !important; }
.text-navy { color: var(--navy) !important; }

.analytics-card {
    background: #fff; border-radius: 16px; border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 20px;
    height: 100%; border-left: 5px solid var(--tq);
}
.analytics-card-navy    { border-left-color: var(--navy); }
.analytics-card-success { border-left-color: var(--success); }
.analytics-card-danger  { border-left-color: var(--danger); }
.analytics-card-warning { border-left-color: var(--warning); }

.card-dashboard {
    background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.06);
    padding: 1.25rem 1.5rem; transition: box-shadow 0.2s ease;
}
.card-dashboard:hover { box-shadow: 0 8px 24px var(--tq-glow); }

.btn-turquoise {
    background-color: var(--tq); color: #fff; border: none; border-radius: 10px;
    font-size: 14px; font-weight: 500; transition: background 0.18s, transform 0.15s;
}
.btn-turquoise:hover { background-color: var(--tq-dark); color: #fff; transform: translateY(-2px); }

.btn-outline-turquoise {
    color: var(--tq); border: 1.5px solid var(--tq); border-radius: 10px;
    background: transparent; font-size: 14px; font-weight: 500;
}
.btn-outline-turquoise:hover { background-color: var(--tq-light); color: var(--tq); }

.btn-soft-danger { background: rgba(226,109,92,0.1); color: var(--danger); border: none; border-radius: 8px; }

.table thead th {
    border-bottom: 2px solid #9ba8b8 !important; color: var(--navy) !important;
    font-weight: 600; text-transform: uppercase; font-size: 11px;
    letter-spacing: 0.07em; padding: 14px 16px;
}
.table tbody td { vertical-align: middle; color: #2d3748; padding: 13px 16px; border-bottom: 1px solid rgba(155,168,184,0.2); }
.table tbody tr:hover { background: rgba(5,130,142,0.04); }

.badge-paid     { background-color: #d1fae5; color: #065f46; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }
.badge-pending  { background-color: #fef3c7; color: #92400e; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }
.badge-failed   { background-color: #fee2e2; color: #991b1b; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }
.badge-refunded { background-color: #e0e7ff; color: #3730a3; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }

.form-control, .form-select { border: 1px solid rgba(155,168,184,0.5); }
.form-control:focus, .form-select:focus { border-color: var(--tq); box-shadow: 0 0 0 0.25rem var(--tq-glow); }
</style>

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0">Payments & Transactions</h2>
            <p class="text-muted mb-0">Monitor billing and subscription revenue across all tenants.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-turquoise shadow-sm px-4 py-2" data-bs-toggle="modal" data-bs-target="#manualPaymentModal">
                <i class="bi bi-plus-circle me-2"></i>Record Payment
            </button>
        </div>
    </div>

    <!-- Analytics Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.75rem;">Total Revenue</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.TotalRevenue.ToString("C2")</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                        <i class="bi bi-cash-stack text-turquoise fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-navy">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.75rem;">This Month</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.MonthlyRevenue.ToString("C2")</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                        <i class="bi bi-calendar-check text-navy fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-success">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.75rem;">Successful</h6>
                        <h3 class="fw-bold text-success mb-0">@Model.SuccessfulPayments</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(16,185,129,0.1);width:48px;height:48px;">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-danger">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.75rem;">Failed</h6>
                        <h3 class="fw-bold text-danger mb-0">@Model.FailedPayments</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(226,109,92,0.1);width:48px;height:48px;">
                        <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue Chart -->
    <div class="card card-dashboard mb-4">
        <h5 class="fw-bold text-navy mb-3 ps-2"><i class="bi bi-graph-up me-2 text-turquoise"></i>Monthly Revenue (Last 6 Months)</h5>
        <canvas id="revenueChart" height="80"></canvas>
    </div>

    <!-- Data Table Card -->
    <div class="card card-dashboard mb-4 mt-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
            <h5 class="fw-bold text-navy mb-0 ps-2"><i class="bi bi-credit-card-2-front-fill me-2 text-turquoise"></i>Payment Records</h5>
            <form asp-action="Payments" method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <select name="statusFilter" class="form-select rounded-3 shadow-sm" style="width:140px;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter) ? "selected" : null)">All Statuses</option>
                    <option value="Paid" selected="@(Model.StatusFilter == "Paid" ? "selected" : null)">Paid</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
                    <option value="Failed" selected="@(Model.StatusFilter == "Failed" ? "selected" : null)">Failed</option>
                    <option value="Refunded" selected="@(Model.StatusFilter == "Refunded" ? "selected" : null)">Refunded</option>
                </select>
                <select name="methodFilter" class="form-select rounded-3 shadow-sm" style="width:130px;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.MethodFilter) ? "selected" : null)">All Methods</option>
                    <option value="Stripe" selected="@(Model.MethodFilter == "Stripe" ? "selected" : null)">Stripe</option>
                    <option value="Manual" selected="@(Model.MethodFilter == "Manual" ? "selected" : null)">Manual</option>
                </select>
                <select name="dateRangeFilter" class="form-select rounded-3 shadow-sm" style="width:140px;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.DateRangeFilter) ? "selected" : null)">All Time</option>
                    <option value="Today" selected="@(Model.DateRangeFilter == "Today" ? "selected" : null)">Today</option>
                    <option value="ThisWeek" selected="@(Model.DateRangeFilter == "ThisWeek" ? "selected" : null)">This Week</option>
                    <option value="ThisMonth" selected="@(Model.DateRangeFilter == "ThisMonth" ? "selected" : null)">This Month</option>
                    <option value="Last90Days" selected="@(Model.DateRangeFilter == "Last90Days" ? "selected" : null)">Last 90 Days</option>
                </select>
                <div class="input-group shadow-sm rounded-3 overflow-hidden" style="width:250px;">
                    <span class="input-group-text bg-white border-muted text-turquoise"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control border-muted border-start-0 shadow-none" placeholder="Search company or plan..." />
                </div>
                <button type="submit" class="btn btn-turquoise rounded-3 px-3 shadow-sm fw-semibold">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.StatusFilter) || !string.IsNullOrEmpty(Model.MethodFilter) || !string.IsNullOrEmpty(Model.DateRangeFilter))
                {
                    <a asp-action="Payments" class="btn btn-light rounded-3 text-danger shadow-sm"><i class="bi bi-x-circle"></i> Clear</a>
                }
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive rounded-top-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Tenant / Company</th>
                            <th>Plan</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Payments != null && Model.Payments.Any())
                        {
                            foreach (var payment in Model.Payments)
                            {
                                var statusBadge = payment.Status.ToLower() switch
                                {
                                    "paid" => "badge-paid",
                                    "pending" => "badge-pending",
                                    "failed" => "badge-failed",
                                    "refunded" => "badge-refunded",
                                    _ => "badge-pending"
                                };
                                var methodIcon = payment.PaymentMethod == "Stripe" ? "bi-stripe" : "bi-pencil-square";

                                <tr>
                                    <td class="ps-4 fw-semibold text-navy">@payment.TenantName</td>
                                    <td class="text-secondary">@payment.PlanName</td>
                                    <td class="fw-bold">@payment.AmountPaid.ToString("C2")</td>
                                    <td class="text-secondary">
                                        <i class="bi @methodIcon me-1 text-muted"></i> @payment.PaymentMethod
                                    </td>
                                    <td><span class="badge @statusBadge">@payment.Status</span></td>
                                    <td class="text-secondary small">@payment.TransactionDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-turquoise px-3"
                                                onclick="openPaymentDetails(@payment.PaymentID)"
                                                title="View Details">
                                            <i class="bi bi-eye me-1"></i>Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt fs-1 d-block mb-3 text-turquoise"></i>
                                    No payment records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-white" style="border-radius:0 0 16px 16px;">
                    <span class="text-muted small fw-medium">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <ul class="pagination pagination-sm mb-0 shadow-sm">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Payments" asp-route-page="@i"
                                   asp-route-searchString="@Model.SearchString" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-methodFilter="@Model.MethodFilter" asp-route-dateRangeFilter="@Model.DateRangeFilter">@i</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════════ PAYMENT DETAILS MODAL ═══════════ -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header border-0" style="background:#080b11;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                         style="width:38px;height:38px;background:rgba(5,130,142,0.15);">
                        <i class="bi bi-receipt-cutoff" style="color:var(--tq);"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0">Payment Details</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background:#fff;">
                <div id="payModalLoading" class="text-center py-4"><div class="spinner-border text-turquoise" role="status"></div></div>
                <div id="payModalContent" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-bottom-style:dashed!important;">
                        <div>
                            <h4 class="fw-bold text-navy mb-1" id="pmAmount">₱0.00</h4>
                            <span class="badge badge-paid" id="pmStatus">Status</span>
                        </div>
                        <div class="text-end">
                            <p class="text-muted small mb-0">Payment #<span class="font-monospace" id="pmId">0</span></p>
                            <p class="fw-semibold text-navy mb-0 small" id="pmDate"></p>
                        </div>
                    </div>
                    <div class="row mb-3"><div class="col-5 text-muted small fw-medium"><i class="bi bi-building me-1"></i> Tenant</div><div class="col-7 fw-semibold text-navy text-end" id="pmCompany"></div></div>
                    <div class="row mb-3"><div class="col-5 text-muted small fw-medium"><i class="bi bi-box me-1"></i> Plan</div><div class="col-7 fw-semibold text-navy text-end" id="pmPlan"></div></div>
                    <div class="row mb-3"><div class="col-5 text-muted small fw-medium"><i class="bi bi-credit-card me-1"></i> Method</div><div class="col-7 fw-semibold text-navy text-end" id="pmMethod"></div></div>
                    <div class="row mb-3"><div class="col-5 text-muted small fw-medium"><i class="bi bi-card-checklist me-1"></i> Subscription</div><div class="col-7 fw-semibold text-navy text-end small" id="pmSubInfo"></div></div>
                    <div id="pmStripeSection" class="mt-3 pt-3 border-top">
                        <h6 class="fw-bold text-navy mb-3"><i class="bi bi-stripe me-1 text-turquoise"></i>Stripe Details</h6>
                        <div class="row mb-2"><div class="col-4 text-muted small">Session ID</div><div class="col-8 text-end"><code class="small" id="pmSessionId">—</code></div></div>
                        <div class="row mb-2"><div class="col-4 text-muted small">Payment Intent</div><div class="col-8 text-end"><code class="small" id="pmIntentId">—</code></div></div>
                        <div class="row"><div class="col-4 text-muted small">Customer ID</div><div class="col-8 text-end"><code class="small" id="pmCustId">—</code></div></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0" style="background:#fff;">
                <button type="button" class="btn btn-turquoise fw-semibold shadow-sm w-100" data-bs-dismiss="modal" style="border-radius:10px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ MANUAL PAYMENT MODAL ═══════════ -->
<div class="modal fade" id="manualPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header border-0" style="background:#080b11;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                         style="width:38px;height:38px;background:rgba(5,130,142,0.15);">
                        <i class="bi bi-plus-circle" style="color:var(--tq);"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0">Record Manual Payment</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateManualPayment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4" style="background:#fff;">
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Select Tenant</label>
                        <select name="tenantId" class="form-select" required>
                            <option value="">-- Select a Tenant --</option>
                            @if (ViewBag.PaymentTenants != null)
                            {
                                foreach (var t in ViewBag.PaymentTenants)
                                {
                                    <option value="@t.TenantID">@t.CompanyName</option>
                                }
                            }
                        </select>
                        <div class="form-text small text-muted">Tenant must have an existing subscription.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Amount (USD)</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" name="amount" class="form-control" step="0.01" min="0.01" required placeholder="0.00" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Notes (optional)</label>
                        <input type="text" name="notes" class="form-control" placeholder="e.g. Offline bank transfer" />
                    </div>
                    <div class="alert border-0" style="background:var(--tq-light);color:var(--tq-dark);border-radius:10px;">
                        <i class="bi bi-info-circle me-2"></i>This will create a "Paid" payment record with method "Manual".
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3" style="background:#f8f9fa;">
                    <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                    <button type="submit" class="btn btn-turquoise shadow-sm px-4" style="border-radius:10px;">Record Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Revenue Chart
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueData.Select(m => m.Month)));
    const revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueData.Select(m => m.Revenue)));

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue (₱)',
                data: revenues,
                backgroundColor: 'rgba(5, 130, 142, 0.15)',
                borderColor: '#05828e',
                borderWidth: 2,
                borderRadius: 8,
                hoverBackgroundColor: 'rgba(5, 130, 142, 0.35)'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { callback: v => '₱' + v } },
                x: { grid: { display: false } }
            }
        }
    });

    // AJAX Payment Details
    function openPaymentDetails(payId) {
        document.getElementById('payModalLoading').style.display = 'block';
        document.getElementById('payModalContent').style.display = 'none';
        var modal = new bootstrap.Modal(document.getElementById('paymentDetailsModal'));
        modal.show();

        fetch('/SuperAdmin/PaymentDetails?id=' + payId)
            .then(r => r.json())
            .then(d => {
                document.getElementById('pmId').innerText = d.paymentID;
                document.getElementById('pmAmount').innerText = '₱' + d.amount.toFixed(2);
                document.getElementById('pmDate').innerText = new Date(d.paymentDate).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
                document.getElementById('pmCompany').innerText = d.companyName;
                document.getElementById('pmPlan').innerText = d.planName + ' (₱' + d.planPrice.toFixed(2) + '/mo)';
                document.getElementById('pmMethod').innerText = d.paymentMethod;

                const badge = document.getElementById('pmStatus');
                badge.innerText = d.paymentStatus;
                badge.className = 'badge';
                const s = d.paymentStatus.toLowerCase();
                badge.classList.add(s === 'paid' ? 'badge-paid' : s === 'failed' ? 'badge-failed' : s === 'refunded' ? 'badge-refunded' : 'badge-pending');

                // Subscription info
                if (d.subscriptionStart) {
                    const start = new Date(d.subscriptionStart).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
                    const end = new Date(d.subscriptionEnd).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
                    document.getElementById('pmSubInfo').innerText = d.subscriptionStatus + ' (' + start + ' – ' + end + ')';
                } else {
                    document.getElementById('pmSubInfo').innerText = 'N/A';
                }

                // Stripe section
                document.getElementById('pmSessionId').innerText = d.stripeSessionID || '—';
                document.getElementById('pmIntentId').innerText = d.stripePaymentIntentID || '—';
                document.getElementById('pmCustId').innerText = d.stripeCustomerId || '—';
                document.getElementById('pmStripeSection').style.display = d.paymentMethod === 'Stripe' ? 'block' : 'none';

                document.getElementById('payModalLoading').style.display = 'none';
                document.getElementById('payModalContent').style.display = 'block';
            })
            .catch(() => {
                document.getElementById('payModalLoading').innerHTML = '<p class="text-danger">Failed to load details.</p>';
            });
    }
</script>
}
