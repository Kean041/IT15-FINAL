@model FinSight.Models.ViewModels.SuperAdminTenantViewModel

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Global Tenants";
}

<style>
/* ── Color tokens ──────────────────────────── */
:root {
    --tq: #05828e;
    --tq-dark: #047078;
    --tq-light: rgba(5, 130, 142, 0.08);
    --tq-glow: rgba(5, 130, 142, 0.18);
    --navy: #162229;
    --danger: #E26D5C;
    --danger-dark: #c95c4d;
    --success: #10b981;
    --success-light: rgba(16, 185, 129, 0.08);
    --warning: #f59e0b;
    --warning-light: rgba(245, 158, 11, 0.08);
    --muted-color: #9ba8b8;
}

/* ── Backgrounds & Text ────────────────────── */
.bg-offwhite    { background-color: #e7eaef; }
.bg-turquoise   { background-color: var(--tq) !important; color: #fff; }
.text-turquoise { color: var(--tq) !important; }
.text-navy      { color: var(--navy) !important; }
.border-muted   { border-color: var(--muted-color) !important; }

/* ── Cards ─────────────────────────────────── */
.card-dashboard {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 0.2s ease;
}
.card-dashboard:hover {
    box-shadow: 0 8px 24px var(--tq-glow), 0 2px 8px rgba(0, 0, 0, 0.04);
}

.analytics-card {
    background: #ffffff;
    border-radius: 16px;
    border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    padding: 20px;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-left: 5px solid var(--tq);
}
.analytics-card-navy    { border-left-color: var(--navy); }
.analytics-card-success { border-left-color: var(--success); }
.analytics-card-warning { border-left-color: var(--warning); }
.analytics-card-danger  { border-left-color: var(--danger); }

/* ── Buttons ───────────────────────────────── */
.btn-turquoise {
    background-color: var(--tq);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: background 0.18s, transform 0.15s, box-shadow 0.18s;
}
.btn-turquoise:hover {
    background-color: var(--tq-dark);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px var(--tq-glow);
}

.btn-outline-turquoise {
    color: var(--tq);
    border: 1.5px solid var(--tq);
    border-radius: 10px;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
}
.btn-outline-turquoise:hover {
    background-color: var(--tq-light);
    color: var(--tq);
    box-shadow: 0 0 0 3px var(--tq-glow);
}

.btn-soft-danger {
    background-color: rgba(226, 109, 92, 0.1);
    color: var(--danger);
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s, color 0.18s, transform 0.15s;
}
.btn-soft-danger:hover {
    background-color: var(--danger);
    color: #fff;
    transform: translateY(-1px);
}

.btn-soft-warning {
    background-color: rgba(245, 158, 11, 0.1);
    color: var(--warning);
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s, color 0.18s, transform 0.15s;
}
.btn-soft-warning:hover {
    background-color: var(--warning);
    color: #fff;
    transform: translateY(-1px);
}

/* ── Table ─────────────────────────────────── */
.table thead th {
    border-bottom: 2px solid var(--muted-color) !important;
    color: var(--navy) !important;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.07em;
    background-color: transparent !important;
    padding: 14px 16px;
}
.table tbody td {
    vertical-align: middle;
    color: #2d3748;
    padding: 13px 16px;
    border-bottom: 1px solid rgba(155, 168, 184, 0.2);
}
.table tbody tr {
    transition: background 0.15s;
}
.table tbody tr:hover {
    background: rgba(5, 130, 142, 0.04);
}

/* ── Status Badges ─────────────────────────── */
.badge-active    { background-color: #d1fae5; color: #065f46; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }
.badge-inactive  { background-color: #e5e7eb; color: #4b5563; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }
.badge-suspended { background-color: #fee2e2; color: #991b1b; border-radius: 20px; padding: 5px 12px; font-size: 12px; font-weight: 500; }

/* ── Forms/Inputs ──────────────────────────── */
.form-control, .form-select {
    border: 1px solid rgba(155, 168, 184, 0.5);
}
.form-control:focus, .form-select:focus {
    border-color: var(--tq);
    box-shadow: 0 0 0 0.25rem var(--tq-glow);
}
</style>

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0">Tenant Directory</h2>
            <p class="text-muted mb-0">Manage all registered companies, configure settings, and monitor active statuses.</p>
        </div>
        <div>
            <button class="btn btn-turquoise shadow-sm px-4 py-2" data-bs-toggle="modal" data-bs-target="#registerTenantModal">
                <i class="bi bi-building-add me-2"></i>Register Tenant
            </button>
        </div>
    </div>

    <!-- Analytics Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Tenants -->
        <div class="col-md-3">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Total Tenants</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.TotalTenants</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-buildings text-turquoise fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Active Tenants -->
        <div class="col-md-3">
            <div class="analytics-card analytics-card-success">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Active</h6>
                        <h3 class="fw-bold text-success mb-0">@Model.ActiveTenants</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: var(--success-light); width: 48px; height: 48px;">
                        <i class="bi bi-person-check-fill text-success fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending -->
        <div class="col-md-3">
            <div class="analytics-card analytics-card-warning">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Pending</h6>
                        <h3 class="fw-bold mb-0" style="color: var(--warning);">@Model.PendingTenants</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: var(--warning-light); width: 48px; height: 48px;">
                        <i class="bi bi-hourglass-split fs-5" style="color: var(--warning);"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Suspended/Inactive -->
        <div class="col-md-3">
            <div class="analytics-card analytics-card-danger">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Suspended/Inactive</h6>
                        <h3 class="fw-bold text-danger mb-0">@Model.SuspendedTenants</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(226, 109, 92, 0.1); width: 48px; height: 48px;">
                        <i class="bi bi-shield-x text-danger fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- New Tenants This Month -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="analytics-card analytics-card-navy">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">New (This Month)</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.NewTenantsThisMonth</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-graph-up-arrow text-navy fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card card-dashboard mb-4 mt-2">

        <!-- Search & Filters -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
            <h5 class="fw-bold text-navy mb-0 ps-2"><i class="bi bi-building-fill me-2 text-turquoise"></i>Registered Organizations</h5>

            <form asp-action="Tenants" method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Status Filter -->
                <select name="statusFilter" class="form-select rounded-3 shadow-sm" style="width: 140px;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter) ? "selected" : null)">All Status</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active" ? "selected" : null)">Active</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
                    <option value="Suspended" selected="@(Model.StatusFilter == "Suspended" ? "selected" : null)">Suspended</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive" ? "selected" : null)">Inactive</option>
                </select>

                <!-- Plan Filter -->
                <select name="planFilter" class="form-select rounded-3 shadow-sm" style="width: 150px;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.PlanFilter) ? "selected" : null)">All Plans</option>
                    <option value="Basic" selected="@(Model.PlanFilter == "Basic" ? "selected" : null)">Basic</option>
                    <option value="Premium" selected="@(Model.PlanFilter == "Premium" ? "selected" : null)">Premium</option>
                    <option value="Enterprise" selected="@(Model.PlanFilter == "Enterprise" ? "selected" : null)">Enterprise</option>
                </select>

                <!-- Search Input -->
                <div class="input-group shadow-sm rounded-3 overflow-hidden" style="width: 250px;">
                    <span class="input-group-text bg-white border-muted text-turquoise"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control border-muted border-start-0 shadow-none" placeholder="Search company or email..." />
                </div>
                
                <button type="submit" class="btn btn-turquoise rounded-3 px-3 shadow-sm fw-semibold">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.StatusFilter) || !string.IsNullOrEmpty(Model.PlanFilter))
                {
                    <a asp-action="Tenants" class="btn btn-light rounded-3 text-danger shadow-sm"><i class="bi bi-x-circle"></i> Clear</a>
                }
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive rounded-top-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Company Name</th>
                            <th>Admin Email</th>
                            <th>Subscription Plan</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Tenants != null && Model.Tenants.Any())
                        {
                            foreach (var tenant in Model.Tenants)
                            {
                                var statusBadge = tenant.Status.ToLower() switch
                                {
                                    "active" => "badge-active",
                                    "pending" => "badge-inactive",
                                    "inactive" => "badge-inactive",
                                    "suspended" => "badge-suspended",
                                    _ => "badge-inactive"
                                };

                                <tr>
                                    <td class="ps-4 fw-semibold text-navy">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-offwhite d-flex align-items-center justify-content-center me-3" style="width:32px; height:32px;">
                                                <i class="bi bi-building text-turquoise small"></i>
                                            </div>
                                            @tenant.CompanyName
                                        </div>
                                    </td>
                                    <td class="text-secondary">@tenant.AdminEmail</td>
                                    <td class="text-secondary fw-medium">
                                        <i class="bi bi-box me-1 text-turquoise"></i> @tenant.SubscriptionPlan
                                    </td>
                                    <td><span class="badge @statusBadge">@tenant.Status</span></td>
                                    <td class="text-secondary small">@tenant.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button class="btn btn-sm btn-outline-turquoise" 
                                                    onclick="openTenantDetailsModal(@tenant.TenantID)"
                                                    title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (tenant.Status.Equals("Active", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="btn btn-sm btn-soft-danger" title="Suspend Tenant" 
                                                        onclick="openStatusModal(@tenant.TenantID, '@tenant.CompanyName.Replace("'", "\\'")', 'Suspended')">
                                                    <i class="bi bi-shield-x"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-soft-warning" title="Activate Tenant"
                                                        onclick="openStatusModal(@tenant.TenantID, '@tenant.CompanyName.Replace("'", "\\'")', 'Active')">
                                                    <i class="bi bi-shield-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-buildings fs-1 d-block mb-3 text-turquoise"></i>
                                    No tenant records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-white" style="border-radius: 0 0 16px 16px;">
                    <span class="text-muted small fw-medium">Showing Page @Model.CurrentPage of @Model.TotalPages</span>
                    <ul class="pagination pagination-sm mb-0 shadow-sm">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Tenants" asp-route-page="@i" asp-route-searchString="@Model.SearchString" asp-route-statusFilter="@Model.StatusFilter" asp-route-planFilter="@Model.PlanFilter">@i</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════════ TENANT DETAILS MODAL ═══════════ -->
<div class="modal fade" id="tenantDetailsModal" tabindex="-1" aria-labelledby="tenantDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header border-0" style="background:#080b11;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                         style="width:38px;height:38px;background:rgba(5, 130, 142, 0.15);">
                        <i class="bi bi-building-fill" style="color:var(--tq);"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="tenantDetailsModalLabel">Tenant Information</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background:#fff;">
                <div id="modalLoading" class="text-center py-4"><div class="spinner-border text-turquoise" role="status"></div></div>
                <div id="modalContent" style="display:none;">
                    <div class="text-center mb-4 pb-4 border-bottom border-muted" style="border-bottom-style: dashed !important;">
                        <h4 class="fw-bold text-navy mb-1" id="modalCompany">Company Name</h4>
                        <span class="badge badge-active mb-2" id="modalStatus">Status</span>
                        <p class="text-muted small mb-0">Tenant ID: <span class="font-monospace" id="modalId">#0000</span></p>
                    </div>
                    <div class="row mb-3">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-person-fill me-1"></i> Admin Name</div>
                        <div class="col-7 fw-semibold text-navy text-end" id="modalAdminName">N/A</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-envelope-at me-1"></i> Admin Email</div>
                        <div class="col-7 fw-semibold text-navy text-end" id="modalEmail">N/A</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-box me-1"></i> Subscription Plan</div>
                        <div class="col-7 fw-semibold text-navy text-end" id="modalPlan">None</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-people-fill me-1"></i> Total Users</div>
                        <div class="col-7 fw-semibold text-navy text-end" id="modalUsers">0</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-stripe me-1"></i> Stripe Customer</div>
                        <div class="col-7 fw-semibold text-navy text-end small" id="modalStripe">—</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted small fw-medium"><i class="bi bi-calendar-plus me-1"></i> Registered</div>
                        <div class="col-7 fw-semibold text-navy text-end" id="modalCreated">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0" style="background:#fff;">
                <button type="button" class="btn btn-turquoise fw-semibold shadow-sm w-100" data-bs-dismiss="modal" style="border-radius:10px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ STATUS CONFIRMATION MODAL ═══════════ -->
<div class="modal fade" id="statusConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-body p-4 text-center">
                <div id="statusModalIcon" class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; background: rgba(245, 158, 11, 0.1);">
                        <i class="bi bi-exclamation-triangle-fill fs-2" style="color: var(--warning);"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-navy mb-2" id="statusModalTitle">Confirm Action</h5>
                <p class="text-muted small mb-4" id="statusModalMessage">Are you sure you want to change this tenant's status?</p>
                
                <form asp-action="UpdateTenantStatus" method="post" id="statusModalForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="statusModalTenantId" />
                    <input type="hidden" name="status" id="statusModalNewStatus" />
                    
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light shadow-sm w-50" data-bs-dismiss="modal" style="border-radius:10px; font-weight: 500;">Cancel</button>
                        <button type="submit" class="btn btn-turquoise shadow-sm w-50" id="statusModalSubmitBtn" style="border-radius:10px; font-weight: 500;">Confirm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ REGISTER TENANT MODAL ═══════════ -->
<div class="modal fade" id="registerTenantModal" tabindex="-1" aria-labelledby="registerTenantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header border-0" style="background:#080b11;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                         style="width:38px;height:38px;background:rgba(5, 130, 142, 0.15);">
                        <i class="bi bi-building-add" style="color:var(--tq);"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="registerTenantModalLabel">Register New Tenant</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="RegisterTenant" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4" style="background:#fff;">
                    
                    <h6 class="text-uppercase text-muted fw-bold small mb-3" style="letter-spacing: 1px;">Company Information</h6>
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Company Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-muted text-muted"><i class="bi bi-building"></i></span>
                            <input type="text" name="CompanyName" class="form-control border-muted" required placeholder="e.g. Acme Corporation" />
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-navy small">Subscription Plan</label>
                            <select name="SubscriptionPlan" class="form-select border-muted" required>
                                <option value="Basic">Basic (₱29/mo)</option>
                                <option value="Premium">Premium (₱79/mo)</option>
                                <option value="Enterprise">Enterprise (₱299/mo)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-navy small">Initial Status</label>
                            <select name="SubscriptionStatus" class="form-select border-muted" required>
                                <option value="Active">Active</option>
                                <option value="Pending">Pending</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="text-uppercase text-muted fw-bold small mb-3 border-top pt-3" style="letter-spacing: 1px;">Admin User Account</h6>
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Admin Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-muted text-muted"><i class="bi bi-person"></i></span>
                            <input type="text" name="AdminName" class="form-control border-muted" required placeholder="John Doe" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Admin Email (Login)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-muted text-muted"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="AdminEmail" class="form-control border-muted" required placeholder="admin@company.com" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-medium text-navy small">Temporary Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-muted text-muted"><i class="bi bi-key"></i></span>
                            <input type="password" name="AdminPassword" class="form-control border-muted" required minlength="8" placeholder="Minimum 8 characters" />
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-top px-4 py-3" style="background:#f8f9fa;">
                    <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                    <button type="submit" class="btn btn-turquoise shadow-sm px-4" style="border-radius:10px;">Create Tenant</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openTenantDetailsModal(tenantId) {
        document.getElementById('modalLoading').style.display = 'block';
        document.getElementById('modalContent').style.display = 'none';

        var modal = new bootstrap.Modal(document.getElementById('tenantDetailsModal'));
        modal.show();

        fetch('/SuperAdmin/TenantDetails?id=' + tenantId)
            .then(r => r.json())
            .then(data => {
                document.getElementById('modalId').innerText = 'TN-' + String(data.tenantID).padStart(4, '0');
                document.getElementById('modalCompany').innerText = data.companyName;
                document.getElementById('modalAdminName').innerText = data.adminName;
                document.getElementById('modalEmail').innerText = data.adminEmail;
                document.getElementById('modalPlan').innerText = data.subscriptionPlan;
                document.getElementById('modalUsers').innerText = data.totalUsers;
                document.getElementById('modalStripe').innerText = data.stripeCustomerId || '—';
                document.getElementById('modalCreated').innerText = data.createdDate ? new Date(data.createdDate).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : '—';

                const badge = document.getElementById('modalStatus');
                badge.innerText = data.subscriptionStatus;
                badge.className = 'badge mb-2';
                const s = data.subscriptionStatus.toLowerCase();
                if (s === 'active') badge.classList.add('badge-active');
                else if (s === 'suspended') badge.classList.add('badge-suspended');
                else badge.classList.add('badge-inactive');

                document.getElementById('modalLoading').style.display = 'none';
                document.getElementById('modalContent').style.display = 'block';
            })
            .catch(() => {
                document.getElementById('modalLoading').innerHTML = '<p class="text-danger">Failed to load tenant details.</p>';
            });
    }

    function openStatusModal(tenantId, companyName, newStatus) {
        document.getElementById('statusModalTenantId').value = tenantId;
        document.getElementById('statusModalNewStatus').value = newStatus;
        
        const isActivating = (newStatus === 'Active');
        
        // Update Modal UI
        document.getElementById('statusModalTitle').innerText = isActivating ? 'Activate Tenant' : 'Suspend Tenant';
        document.getElementById('statusModalMessage').innerHTML = isActivating 
            ? `Are you sure you want to grant <strong>${companyName}</strong> full access to the system?`
            : `Are you sure you want to suspend <strong>${companyName}</strong>? They will be locked out immediately.`;
            
        // Style icon & button based on action
        const iconContainer = document.getElementById('statusModalIcon').firstElementChild;
        const icon = iconContainer.firstElementChild;
        const btn = document.getElementById('statusModalSubmitBtn');
        
        if (isActivating) {
            iconContainer.style.background = 'rgba(16, 185, 129, 0.1)';
            icon.className = 'bi bi-shield-check fs-2 text-success';
            btn.className = 'btn btn-success shadow-sm w-50';
            btn.innerText = 'Activate';
        } else {
            iconContainer.style.background = 'rgba(226, 109, 92, 0.1)';
            icon.className = 'bi bi-shield-x fs-2 text-danger';
            btn.className = 'btn btn-danger shadow-sm w-50';
            btn.innerText = 'Suspend';
        }
        
        var modal = new bootstrap.Modal(document.getElementById('statusConfirmModal'));
        modal.show();
    }
</script>
}
