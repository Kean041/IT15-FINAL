@model FinSight.Models.ViewModels.SuperAdminDashboardViewModel
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Dashboard";
}

<style>
:root {
    --tq: #05828e; --tq-dark: #047078; --tq-light: rgba(5,130,142,0.08);
    --tq-glow: rgba(5,130,142,0.18); --navy: #162229;
    --danger: #E26D5C; --success: #10b981; --warning: #f59e0b;
}
.bg-offwhite { background-color: #e7eaef; }
.text-turquoise { color: var(--tq) !important; }
.text-navy { color: var(--navy) !important; }

.analytics-card {
    background: #fff; border-radius: 16px; border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 20px;
    height: 100%; border-left: 5px solid var(--tq); transition: box-shadow 0.2s;
}
.analytics-card:hover { box-shadow: 0 8px 24px var(--tq-glow); }
.analytics-card-navy    { border-left-color: var(--navy); }
.analytics-card-success { border-left-color: var(--success); }
.analytics-card-danger  { border-left-color: var(--danger); }
.analytics-card-warning { border-left-color: var(--warning); }

.card-dash {
    background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.06);
    transition: box-shadow 0.2s;
}
.card-dash:hover { box-shadow: 0 8px 24px var(--tq-glow); }

.badge-active    { background-color: #d1fae5; color: #065f46; border-radius: 20px; padding: 4px 10px; font-size: 11px; }
.badge-pending   { background-color: #fef3c7; color: #92400e; border-radius: 20px; padding: 4px 10px; font-size: 11px; }
.badge-suspended { background-color: #fee2e2; color: #991b1b; border-radius: 20px; padding: 4px 10px; font-size: 11px; }
.badge-expired   { background-color: #e5e7eb; color: #374151; border-radius: 20px; padding: 4px 10px; font-size: 11px; }
.badge-paid      { background-color: #d1fae5; color: #065f46; border-radius: 20px; padding: 4px 10px; font-size: 11px; }
.badge-failed    { background-color: #fee2e2; color: #991b1b; border-radius: 20px; padding: 4px 10px; font-size: 11px; }

.table-mini thead th {
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--navy); font-weight: 700; padding: 10px 12px;
    border-bottom: 2px solid rgba(155,168,184,0.3) !important;
}
.table-mini tbody td { padding: 10px 12px; font-size: 13px; vertical-align: middle; border-bottom: 1px solid rgba(155,168,184,0.15); }
.table-mini tbody tr:hover { background: rgba(5,130,142,0.03); }

.stat-mini { text-align: center; padding: 12px 8px; }
.stat-mini h5 { font-weight: 700; margin-bottom: 2px; }
.stat-mini p  { font-size: 11px; color: #9ba8b8; margin-bottom: 0; text-transform: uppercase; letter-spacing: 0.04em; }
</style>

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0">System Overview</h2>
            <p class="text-muted mb-0">Real-time SaaS metrics across all tenants.</p>
        </div>
    </div>

    <!-- ═══ KPI Summary Cards ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.7rem;">Total Tenants</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.TotalTenants</h3>
                        <span class="text-muted" style="font-size:11px;">@Model.ActiveTenants active</span>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;">
                        <i class="bi bi-buildings-fill fs-5 text-turquoise"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-navy">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.7rem;">Active Subscriptions</h6>
                        <h3 class="fw-bold text-navy mb-0">@Model.ActiveSubscriptions</h3>
                        <span class="text-muted" style="font-size:11px;">of @Model.TotalSubscriptions total</span>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;">
                        <i class="bi bi-bookmark-star-fill fs-5" style="color:var(--navy);"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-success">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.7rem;">Total Revenue</h6>
                        <h3 class="fw-bold mb-0" style="color:var(--tq);">@Model.TotalRevenue.ToString("C0")</h3>
                        <span class="text-muted" style="font-size:11px;">@Model.MonthlyRevenue.ToString("C0") this month</span>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:var(--tq-light);width:46px;height:46px;">
                        <i class="bi bi-cash-stack fs-5 text-turquoise"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="analytics-card analytics-card-danger">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size:0.7rem;">New Signups</h6>
                        <h3 class="fw-bold mb-0" style="color:var(--danger);">@Model.NewSignupsThisMonth</h3>
                        <span class="text-muted" style="font-size:11px;">this month</span>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(226,109,92,0.12);width:46px;height:46px;">
                        <i class="bi bi-person-plus-fill fs-5" style="color:var(--danger);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Charts Row ═══ -->
    <div class="row g-3 mb-4">
        <!-- Revenue Chart -->
        <div class="col-lg-8">
            <div class="card-dash p-4 h-100 d-flex flex-column">
                <h6 class="fw-bold text-navy mb-3"><i class="bi bi-graph-up me-2 text-turquoise"></i>Monthly Revenue</h6>
                <div class="flex-grow-1" style="position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Subscription Distribution -->
        <div class="col-lg-4">
            <div class="card-dash p-4 h-100">
                <h6 class="fw-bold text-navy mb-3"><i class="bi bi-pie-chart me-2 text-turquoise"></i>Plans Distribution</h6>
                <canvas id="planChart" height="170"></canvas>
                <p class="text-center text-muted small mt-3 mb-0">Most Popular: <strong class="text-navy">@Model.MostPopularPlan</strong></p>
            </div>
        </div>
    </div>

    <!-- ═══ Quick Stats Row ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card-dash">
                <div class="d-flex">
                    <div class="stat-mini flex-fill border-end"><h5 class="text-navy">@Model.ActiveTenants</h5><p>Active</p></div>
                    <div class="stat-mini flex-fill border-end"><h5 class="text-warning">@Model.PendingTenants</h5><p>Pending</p></div>
                    <div class="stat-mini flex-fill"><h5 class="text-danger">@Model.SuspendedTenants</h5><p>Suspended</p></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dash">
                <div class="d-flex">
                    <div class="stat-mini flex-fill border-end"><h5 class="text-success">@Model.ActiveSubscriptions</h5><p>Active Subs</p></div>
                    <div class="stat-mini flex-fill"><h5 class="text-secondary">@Model.ExpiredSubscriptions</h5><p>Expired</p></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dash">
                <div class="d-flex">
                    <div class="stat-mini flex-fill border-end"><h5 class="text-turquoise">@Model.StripePayments</h5><p>Stripe</p></div>
                    <div class="stat-mini flex-fill"><h5 class="text-navy">@Model.ManualPayments</h5><p>Manual</p></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dash">
                <div class="d-flex">
                    <div class="stat-mini flex-fill border-end"><h5 class="text-success">@Model.TotalPayments</h5><p>Total Pays</p></div>
                    <div class="stat-mini flex-fill"><h5 class="text-danger">@Model.FailedPayments</h5><p>Failed</p></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Recent Activity ═══ -->
    <div class="row g-3 mb-4">
        <!-- Recent Tenants -->
        <div class="col-lg-4">
            <div class="card-dash p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0"><i class="bi bi-buildings me-2 text-turquoise"></i>Recent Tenants</h6>
                    <a asp-action="Tenants" class="text-turquoise small fw-semibold text-decoration-none">View All →</a>
                </div>
                <table class="table table-mini mb-0">
                    <thead><tr><th>Company</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.RecentTenants)
                        {
                            var cls = t.Status.ToLower() switch { "active" => "badge-active", "suspended" => "badge-suspended", _ => "badge-pending" };
                            <tr>
                                <td class="fw-semibold text-navy">@t.CompanyName</td>
                                <td><span class="badge @cls">@t.Status</span></td>
                                <td class="text-muted">@(t.CreatedDate?.ToString("MMM dd") ?? "—")</td>
                            </tr>
                        }
                        @if (!Model.RecentTenants.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No tenants yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Subscriptions -->
        <div class="col-lg-4">
            <div class="card-dash p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0"><i class="bi bi-bookmark-star me-2 text-turquoise"></i>Recent Subscriptions</h6>
                    <a asp-action="Subscriptions" class="text-turquoise small fw-semibold text-decoration-none">View All →</a>
                </div>
                <table class="table table-mini mb-0">
                    <thead><tr><th>Company</th><th>Plan</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.RecentSubscriptions)
                        {
                            var cls = s.Status.ToLower() switch { "active" => "badge-active", "expired" => "badge-expired", _ => "badge-pending" };
                            <tr>
                                <td class="fw-semibold text-navy">@s.CompanyName</td>
                                <td class="text-muted">@s.PlanName</td>
                                <td><span class="badge @cls">@s.Status</span></td>
                            </tr>
                        }
                        @if (!Model.RecentSubscriptions.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No subscriptions yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-lg-4">
            <div class="card-dash p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0"><i class="bi bi-credit-card me-2 text-turquoise"></i>Recent Payments</h6>
                    <a asp-action="Payments" class="text-turquoise small fw-semibold text-decoration-none">View All →</a>
                </div>
                <table class="table table-mini mb-0">
                    <thead><tr><th>Company</th><th>Amount</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.RecentPayments)
                        {
                            var cls = p.Status.ToLower() switch { "paid" => "badge-paid", "failed" => "badge-failed", _ => "badge-pending" };
                            <tr>
                                <td class="fw-semibold text-navy">@p.CompanyName</td>
                                <td class="fw-bold">@p.Amount.ToString("C2")</td>
                                <td><span class="badge @cls">@p.Status</span></td>
                            </tr>
                        }
                        @if (!Model.RecentPayments.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No payments yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // ── Revenue Bar Chart ──
    const revLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(r => r.Month)));
    const revData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Select(r => r.Revenue)));

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: revLabels,
            datasets: [{
                label: 'Revenue (₱)',
                data: revData,
                backgroundColor: 'rgba(5,130,142,0.15)',
                borderColor: '#05828e',
                borderWidth: 2,
                borderRadius: 8,
                hoverBackgroundColor: 'rgba(5,130,142,0.35)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { callback: v => '₱' + v } },
                x: { grid: { display: false } }
            }
        }
    });

    // ── Plan Distribution Doughnut ──
    const planLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubscriptionsByPlan.Select(p => p.PlanName)));
    const planCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubscriptionsByPlan.Select(p => p.Count)));
    const planColors = ['#05828e', '#162229', '#f59e0b', '#E26D5C', '#10b981'];

    new Chart(document.getElementById('planChart'), {
        type: 'doughnut',
        data: {
            labels: planLabels,
            datasets: [{
                data: planCounts,
                backgroundColor: planColors.slice(0, planLabels.length),
                borderWidth: 0, hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            cutout: '65%',
            plugins: {
                legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, pointStyle: 'circle', font: { size: 11 } } }
            }
        }
    });
</script>
}
