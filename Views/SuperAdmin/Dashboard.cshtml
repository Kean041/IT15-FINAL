@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Dashboard";
}

<style>
/* ── Color tokens ──────────────────────────── */
:root {
    --tq: #05828e;
    --tq-dark: #047078;
    --tq-light: rgba(5, 130, 142, 0.08);
    --tq-glow: rgba(5, 130, 142, 0.18);
    --navy: #162229;
    --danger: #E26D5C;
    --danger-dark: #c95c4d;
}

/* Analytics Summary Cards */
.analytics-card {
    background: #ffffff;
    border-radius: 16px;
    border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    padding: 20px;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-left: 5px solid var(--tq);
}
.analytics-card-navy {
    border-left-color: var(--navy);
}
.analytics-card-danger {
    border-left-color: var(--danger);
}
.bg-offwhite {
    background-color: #e7eaef;
}
</style>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0">System Overview</h2>
            <p class="text-muted mb-0">Global metrics and active software deployment data.</p>
        </div>
        <div>
            <button class="btn border-0 shadow-sm px-4 py-2" style="background-color: var(--tq); color: #fff; font-weight: 500; border-radius: 10px;">
                <i class="bi bi-download me-2"></i> Generate Global Report
            </button>
        </div>
    </div>

    <!-- Analytics Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">TOTAL TENANTS</h6>
                        <h3 class="fw-bold text-navy mb-0">42</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-buildings-fill fs-5" style="color: var(--tq);"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="analytics-card analytics-card-navy">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">ACTIVE SUBSCRIPTIONS</h6>
                        <h3 class="fw-bold text-navy mb-0">38</h3>
                    </div>
                    <div class="bg-offwhite rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-bookmark-star-fill fs-5" style="color: var(--navy);"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">TOTAL REVENUE</h6>
                        <h3 class="fw-bold text-turquoise mb-0" style="color: var(--tq);">$124,500</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: var(--tq-light); width: 48px; height: 48px;">
                        <i class="bi bi-cash-stack fs-5" style="color: var(--tq);"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="analytics-card analytics-card-danger">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">NEW SIGNUPS</h6>
                        <h3 class="fw-bold mb-0" style="color: var(--danger);">14</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(226, 109, 92, 0.15); width: 48px; height: 48px;">
                        <i class="bi bi-person-plus-fill fs-5" style="color: var(--danger);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Tenants Placeholder Grid -->
    <div class="card border-0 shadow-sm" style="background-color: #ffffff; border-radius: 16px;">
        <div class="card-header border-0 py-3 d-flex align-items-center" style="background-color: #ffffff; border-radius: 16px 16px 0 0; border-bottom: 1px solid rgba(0,0,0,0.05) !important;">
            <h5 class="mb-0 text-navy fw-bold"><i class="bi bi-graph-up-arrow me-2" style="color: var(--tq);"></i> Analytics Preview</h5>
        </div>
        <div class="card-body p-4 text-center">
            <div style="padding: 3rem 2rem;">
                <i class="bi bi-bar-chart-steps" style="font-size: 3rem; color: #9ba8b8;"></i>
                <h4 class="mt-3" style="color: #162229; font-weight: 700;">Data Visualization Sandbox</h4>
                <p style="color: #9ba8b8; max-width: 500px; margin: 0 auto; line-height: 1.6;">Dynamic charts actively querying the database for cross-tenant registration trajectories will render dynamically in this container.</p>
            </div>
        </div>
    </div>
</div>
