@model IEnumerable<FinSight.Models.ViewModels.BudgetRequestViewModel>

@{
    ViewData["Title"] = "Approval Workflow";
}

<style>
:root {
    --accent:      #05828e;
    --accent-dark: #047078;
    --accent-light:rgba(5,130,142,0.08);
    --accent-glow: rgba(5,130,142,0.18);
    --dark:        #162229;
    --header:      #080b11;
    --muted:       #9ba8b8;
    --bg:          #e7eaef;
    --danger:      #E26D5C;
    --danger-dark: #c95c4d;
    --warning:     #eab308;
    --success:     #10B981;
}
.bg-soft        { background-color: var(--bg); }
.bg-accent      { background-color: var(--accent) !important; color: #fff; }
.text-accent    { color: var(--accent) !important; }
.text-dark-nav  { color: var(--dark) !important; }
.mod-card { background:#fff; border-radius:16px; border:1px solid rgba(155,168,184,.15); padding:1.25rem 1.5rem; }
.stat-card { background:#fff; border-radius:16px; border:none; box-shadow:0 4px 15px rgba(0,0,0,.03); padding:20px; height:100%; border-left:5px solid var(--accent); }
.stat-card-warning { border-left-color: var(--warning); }
.stat-card-success { border-left-color: var(--success); }
.stat-card-danger  { border-left-color: var(--danger); }
.table thead th { border-bottom:2px solid var(--dark)!important; color:#fff!important; font-weight:600; text-transform:uppercase; font-size:11px; letter-spacing:.07em; background:var(--dark)!important; padding:14px 16px; }
.table tbody td { vertical-align:middle; color:#2d3748; padding:13px 16px; border-bottom:1px solid rgba(155,168,184,.12); }
.table tbody tr { transition:background .15s; }
.table tbody tr:hover { background:var(--accent-light); }
.page-item.active .page-link { background:var(--accent); border-color:var(--accent); color:#fff; }
.page-link { color:var(--accent); }
.badge-pending  { background:#fef08a; color:#854d0e; border-radius:20px; padding:5px 12px; font-size:12px; font-weight:600; }
.badge-approved { background:#d1fae5; color:#065f46; border-radius:20px; padding:5px 12px; font-size:12px; font-weight:600; }
.badge-rejected { background:#fee2e2; color:#991b1b; border-radius:20px; padding:5px 12px; font-size:12px; font-weight:600; }
.btn-approve { background:var(--accent); color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:500; padding:6px 12px; transition:all .18s; }
.btn-approve:hover { background:var(--accent-dark); color:#fff; transform:translateY(-1px); box-shadow:0 4px 10px var(--accent-glow); }
.btn-reject { background:var(--danger); color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:500; padding:6px 12px; transition:all .18s; }
.btn-reject:hover { background:var(--danger-dark); color:#fff; transform:translateY(-1px); }
.btn-view { color:var(--dark); border:1.5px solid var(--dark); background:transparent; border-radius:8px; font-size:13px; font-weight:500; padding:5px 12px; transition:all .18s; }
.btn-view:hover { background:var(--dark); color:#fff; }
</style>

<div class="container-fluid px-0">

    <!-- Toast Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark-nav mb-0">Budget Approval Workflow</h2>
            <p class="mb-0" style="color:var(--muted);">Review and manage department budget requests.</p>
        </div>
        @if ((bool)(ViewBag.CanSubmit ?? false))
        {
            <button class="btn btn-approve px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#submitModal">
                <i class="bi bi-plus-circle me-2"></i>Submit Request
            </button>
        }
    </div>

    <!-- Analytics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size:.75rem;letter-spacing:.05em;color:var(--muted);">Total Requests</h6>
                        <h3 class="fw-bold text-dark-nav mb-0">@ViewBag.TotalRequests</h3>
                    </div>
                    <div class="bg-soft rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                        <i class="bi bi-folder-fill text-accent fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-warning">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size:.75rem;letter-spacing:.05em;color:var(--muted);">Pending</h6>
                        <h3 class="fw-bold mb-0 text-warning">@ViewBag.PendingCount</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(234,179,8,0.1);width:48px;height:48px;">
                        <i class="bi bi-hourglass-split text-warning fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-success">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size:.75rem;letter-spacing:.05em;color:var(--muted);">Approved</h6>
                        <h3 class="fw-bold mb-0 text-success">@ViewBag.ApprovedCount</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(16,185,129,0.1);width:48px;height:48px;">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-danger">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size:.75rem;letter-spacing:.05em;color:var(--muted);">Rejected</h6>
                        <h3 class="fw-bold mb-0 text-danger">@ViewBag.RejectedCount</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(226,109,92,0.1);width:48px;height:48px;">
                        <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="mod-card mb-4">

        <!-- Search + Filters -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark-nav mb-0 ps-2"><i class="bi bi-shield-check me-2 text-accent"></i>Workflow Queue</h5>

            <form asp-action="Approval" method="get" class="d-flex align-items-center flex-wrap gap-2">
                <select name="statusFilter" class="form-select border-0 bg-soft shadow-sm rounded-3 fw-medium" style="width:auto;cursor:pointer;color:var(--muted);">
                    @if (ViewBag.Statuses != null)
                    {
                        @foreach (var s in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Statuses)
                        {
                            <option value="@s.Value" selected="@(ViewBag.CurrentStatus == s.Value ? "selected" : null)">@s.Text</option>
                        }
                    }
                </select>

                <select name="departmentFilter" class="form-select border-0 bg-soft shadow-sm rounded-3 fw-medium" style="width:auto;cursor:pointer;color:var(--muted);">
                    <option value="">All Departments</option>
                    @if (ViewBag.Departments != null)
                    {
                        @foreach (var d in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Departments)
                        {
                            <option value="@d.Value" selected="@(ViewBag.CurrentDepartment?.ToString() == d.Value ? "selected" : null)">@d.Text</option>
                        }
                    }
                </select>

                <select name="periodFilter" class="form-select border-0 bg-soft shadow-sm rounded-3 fw-medium" style="width:auto;cursor:pointer;color:var(--muted);">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentPeriod) ? "selected" : null)">All Time</option>
                    <option value="Day" selected="@(ViewBag.CurrentPeriod == "Day" ? "selected" : null)">Today</option>
                    <option value="Week" selected="@(ViewBag.CurrentPeriod == "Week" ? "selected" : null)">This Week</option>
                    <option value="Month" selected="@(ViewBag.CurrentPeriod == "Month" ? "selected" : null)">This Month</option>
                </select>

                <div class="input-group shadow-sm bg-soft rounded-3 border-0 overflow-hidden" style="width:250px;">
                    <span class="input-group-text border-0 bg-transparent text-accent"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-0 shadow-none bg-transparent" placeholder="Search..." />
                </div>

                <button type="submit" class="btn btn-approve rounded-3 px-3 shadow-sm fw-semibold" style="padding:8px 16px;">Search</button>

                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || !string.IsNullOrEmpty(ViewBag.CurrentPeriod as string) || !string.IsNullOrEmpty(ViewBag.CurrentStatus as string) || ViewBag.CurrentDepartment != null)
                {
                    <a asp-action="Approval" class="btn btn-light rounded-3 shadow-sm" style="color:var(--danger);"><i class="bi bi-x-circle"></i></a>
                }
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive rounded-top-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Department</th>
                            <th>Amount (₱)</th>
                            <th>Budget</th>
                            <th>Date Needed</th>
                            <th>Status</th>
                            <th>Submitted By</th>
                            <th>Approved By</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-accent">@item.Title</td>
                                    <td>@item.DepartmentName</td>
                                    <td class="fw-bold">@item.RequestedAmount.ToString("N2")</td>
                                    <td>@item.BudgetCategory</td>
                                    <td>@item.DateNeeded.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge badge-pending"><i class="bi bi-hourglass me-1"></i>Pending</span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="badge badge-approved"><i class="bi bi-check2 me-1"></i>Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-rejected"><i class="bi bi-x-lg me-1"></i>Rejected</span>
                                        }
                                    </td>
                                    <td class="small text-secondary">
                                        @item.SubmittedByName<br />
                                        <span class="text-muted" style="font-size:10px;">@item.SubmittedDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="small text-secondary">@(item.ApprovedByName ?? "-")</td>
                                    <td class="small text-secondary">@(item.ApprovedDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                    <td class="text-end pe-4">
                                        @if (item.Status == "Pending" && (bool)(ViewBag.CanApprove ?? false))
                                        {
                                            <button class="btn btn-approve me-1" onclick="openReviewModal(@item.RequestID, '@item.Title.Replace("'", "\\'")', '@(item.Description?.Replace("'", "\\'") ?? "")', '@item.DepartmentName', '@item.RequestedAmount', '@item.BudgetCategory', '@item.DateNeeded.ToString("MMM dd, yyyy")', '@item.SubmittedByName', '@item.SubmittedDate.ToString("MMM dd, yyyy")')">
                                                <i class="bi bi-check2-circle"></i> Review
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-view" onclick="openViewModal('@item.Title.Replace("'", "\\'")', '@(item.Description?.Replace("'", "\\'") ?? "")', '@item.DepartmentName', '@item.RequestedAmount', '@item.BudgetCategory', '@item.DateNeeded.ToString("MMM dd, yyyy")', '@item.SubmittedByName', '@item.SubmittedDate.ToString("MMM dd, yyyy")', '@item.Status', '@(item.ApprovedByName ?? "-")', '@(item.ApprovedDate?.ToString("MMM dd, yyyy") ?? "-")', '@(item.RejectionReason?.Replace("'", "\\'") ?? "")')">
                                                <i class="bi bi-eye"></i> View
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5" style="color:var(--muted);">
                                    <i class="bi bi-folder-x fs-1 d-block mb-3 text-accent"></i>
                                    No approval requests found matching your filters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-white" style="border-radius:0 0 16px 16px;">
                    <span class="small fw-medium" style="color:var(--muted);">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                    <ul class="pagination pagination-sm mb-0 shadow-sm">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Approval" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-periodFilter="@ViewBag.CurrentPeriod" asp-route-statusFilter="@ViewBag.CurrentStatus" asp-route-departmentFilter="@ViewBag.CurrentDepartment">@i</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<!-- SUBMIT REQUEST MODAL (Department Head only) -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header bg-dark border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-plus-circle me-2 text-accent"></i>Submit Budget Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SubmitRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4" style="background:var(--bg);">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Budget <span class="text-danger">*</span></label>
                        <select name="BudgetID" class="form-select" required>
                            <option value="">-- Select Budget --</option>
                            @if (ViewBag.Budgets != null)
                            {
                                @foreach (var b in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Budgets)
                                {
                                    <option value="@b.Value">@b.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Request Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" required placeholder="e.g. Q4 Advertising" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Brief justification..."></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Requested Amount (₱) <span class="text-danger">*</span></label>
                            <input type="number" name="RequestedAmount" class="form-control" step="0.01" min="0.01" required placeholder="Enter amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Date Needed <span class="text-danger">*</span></label>
                            <input type="date" name="DateNeeded" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-approve px-4">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REVIEW MODAL (Executive approve/reject with rejection reason) -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header bg-dark border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-shield-check me-2 text-accent"></i>Review Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background:var(--bg);">
                <div class="bg-white rounded-3 p-3 shadow-sm mb-3">
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Title</div><div class="col-7 fw-bold text-dark" id="rvTitle"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Description</div><div class="col-7 text-dark small" id="rvDesc"></div></div>
                    <hr class="my-2" style="border-color:rgba(0,0,0,.05);" />
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Department</div><div class="col-7 fw-bold text-dark" id="rvDept"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Amount</div><div class="col-7 fw-bold text-accent" id="rvAmount"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Budget Category</div><div class="col-7 text-dark" id="rvBudget"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Date Needed</div><div class="col-7 text-dark" id="rvDateNeeded"></div></div>
                    <hr class="my-2" style="border-color:rgba(0,0,0,.05);" />
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Submitted By</div><div class="col-7 text-dark" id="rvSubmitter"></div></div>
                    <div class="row"><div class="col-5 text-muted small fw-semibold">Date</div><div class="col-7 text-dark" id="rvDate"></div></div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-approve flex-grow-1 py-2 fs-6 fw-semibold shadow-sm" onclick="openApproveModal()">
                        <i class="bi bi-check-circle me-1"></i> Approve
                    </button>
                    <button type="button" class="btn btn-reject flex-grow-1 py-2 fs-6 fw-semibold shadow-sm" onclick="openRejectModal()">
                        <i class="bi bi-x-circle me-1"></i> Reject
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- APPROVE CONFIRMATION MODAL -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-question-circle text-success mb-3" style="font-size:3.5rem;"></i>
                <h5 class="fw-bold text-dark mb-2">Confirm Approval</h5>
                <p class="text-muted small mb-4">Are you sure you want to approve this budget request?</p>
                <form id="approveForm" asp-action="ApproveRequest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="approveModalId" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-grow-1 fw-medium" onclick="cancelApproveModal()">Cancel</button>
                        <button type="submit" class="btn btn-approve flex-grow-1 fw-medium">
                            <i class="bi bi-check-circle me-1"></i> Confirm Approve
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- REJECT CONFIRMATION MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header bg-danger border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-x-circle me-2"></i>Reject Request</h5>
                <button type="button" class="btn-close btn-close-white" onclick="cancelRejectModal()"></button>
            </div>
            <form id="rejectForm" asp-action="RejectRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 bg-white">
                    <p class="text-dark small mb-3">You are about to reject this request. Please provide a valid reason.</p>
                    <input type="hidden" name="id" id="rejectModalId" />
                    <label class="form-label fw-semibold text-danger small">Rejection Reason <span class="text-danger">*</span></label>
                    <textarea name="rejectionReason" id="rejectReasonInputModal" class="form-control mb-2 shadow-sm" rows="3" placeholder="Provide reason for rejection..." required></textarea>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-light fw-medium" onclick="cancelRejectModal()">Cancel</button>
                    <button type="submit" class="btn btn-reject fw-medium px-4 shadow-sm">
                        <i class="bi bi-x-circle me-1"></i> Confirm Reject
                    </button>
                </div>
            </form>
            </div>
        </div>
    </div>
</div>

<!-- VIEW MODAL (read-only details) -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header bg-dark border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-eye me-2 text-accent"></i>Request Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background:var(--bg);">
                <div class="bg-white rounded-3 p-3 shadow-sm">
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Title</div><div class="col-7 fw-bold text-dark" id="vmTitle"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Description</div><div class="col-7 text-dark small" id="vmDesc"></div></div>
                    <hr class="my-2" style="border-color:rgba(0,0,0,.05);" />
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Department</div><div class="col-7 fw-bold text-dark" id="vmDept"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Amount</div><div class="col-7 fw-bold text-accent" id="vmAmount"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Budget Category</div><div class="col-7 text-dark" id="vmBudget"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Date Needed</div><div class="col-7 text-dark" id="vmDateNeeded"></div></div>
                    <hr class="my-2" style="border-color:rgba(0,0,0,.05);" />
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Status</div><div class="col-7" id="vmStatus"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Submitted By</div><div class="col-7 text-dark" id="vmSubmitter"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Date</div><div class="col-7 text-dark" id="vmDate"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Approved By</div><div class="col-7 text-dark" id="vmApprover"></div></div>
                    <div class="row mb-2"><div class="col-5 text-muted small fw-semibold">Approval Date</div><div class="col-7 text-dark" id="vmApprovalDate"></div></div>
                    <div id="vmReasonRow" class="row" style="display:none;"><div class="col-5 text-muted small fw-semibold">Rejection Reason</div><div class="col-7 text-danger fw-semibold" id="vmReason"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var reviewModalInstance;
    var approveModalInstance;
    var rejectModalInstance;

    document.addEventListener('DOMContentLoaded', function () {
        reviewModalInstance = new bootstrap.Modal(document.getElementById('reviewModal'));
        approveModalInstance = new bootstrap.Modal(document.getElementById('approveModal'));
        rejectModalInstance = new bootstrap.Modal(document.getElementById('rejectModal'));
    });

    function openReviewModal(id, title, desc, dept, amount, budget, dateNeeded, submitter, date) {
        // Store the ID globally for the modals
        document.getElementById('approveModalId').value = id;
        document.getElementById('rejectModalId').value = id;
        
        document.getElementById('rvTitle').innerText = title;
        document.getElementById('rvDesc').innerText = desc;
        document.getElementById('rvDept').innerText = dept;
        document.getElementById('rvAmount').innerText = '₱' + parseFloat(amount).toLocaleString('en-US', {minimumFractionDigits:2});
        document.getElementById('rvBudget').innerText = budget;
        document.getElementById('rvDateNeeded').innerText = dateNeeded;
        document.getElementById('rvSubmitter').innerText = submitter;
        document.getElementById('rvDate').innerText = date;
        
        reviewModalInstance.show();
    }

    function openApproveModal() {
        reviewModalInstance.hide();
        approveModalInstance.show();
    }

    function cancelApproveModal() {
        approveModalInstance.hide();
        reviewModalInstance.show();
    }

    function openRejectModal() {
        document.getElementById('rejectReasonInputModal').value = '';
        reviewModalInstance.hide();
        rejectModalInstance.show();
    }

    function cancelRejectModal() {
        rejectModalInstance.hide();
        reviewModalInstance.show();
    }

    function openViewModal(title, desc, dept, amount, budget, dateNeeded, submitter, date, status, approver, approvalDate, reason) {
        document.getElementById('vmTitle').innerText = title;
        document.getElementById('vmDesc').innerText = desc;
        document.getElementById('vmDept').innerText = dept;
        document.getElementById('vmAmount').innerText = '₱' + parseFloat(amount).toLocaleString('en-US', {minimumFractionDigits:2});
        document.getElementById('vmBudget').innerText = budget;
        document.getElementById('vmDateNeeded').innerText = dateNeeded;
        document.getElementById('vmSubmitter').innerText = submitter;
        document.getElementById('vmDate').innerText = date;
        document.getElementById('vmStatus').innerHTML = status === 'Approved' ? '<span class="badge badge-approved">Approved</span>' : '<span class="badge badge-rejected">Rejected</span>';
        document.getElementById('vmApprover').innerText = approver;
        document.getElementById('vmApprovalDate').innerText = approvalDate;
        var reasonRow = document.getElementById('vmReasonRow');
        if (reason && reason.length > 0) { reasonRow.style.display = 'flex'; document.getElementById('vmReason').innerText = reason; } else { reasonRow.style.display = 'none'; }
        new bootstrap.Modal(document.getElementById('viewModal')).show();
    }
</script>
