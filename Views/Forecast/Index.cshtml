@model IEnumerable<FinSight.Models.ViewModels.DynamicForecastViewModel>

@{
    ViewData["Title"] = "Financial Forecasting";
}

<style>
/* ── Color tokens ──────────────────────────── */
:root {
    --tq: #05828e;
    --tq-dark: #047078;
    --tq-light: rgba(5, 130, 142, 0.08);
    --tq-glow: rgba(5, 130, 142, 0.18);
    --navy: #162229;
    --danger: #E26D5C;
    --danger-dark: #c95c4d;
}

/* ── Utilities ─────────────────────────────── */
.bg-offwhite    { background-color: #e7eaef; }
.bg-turquoise   { background-color: var(--tq) !important; color: #fff; }
.text-turquoise { color: var(--tq) !important; }
.text-navy      { color: var(--navy) !important; }

/* ── Cards ─────────────────────────────────── */
.card-dashboard {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.06);
    padding: 1.25rem 1.5rem;
    transition: box-shadow .2s ease;
}
.card-dashboard:hover {
    box-shadow: 0 8px 24px var(--tq-glow), 0 2px 8px rgba(0,0,0,.04);
}

.analytics-card {
    background: #fff;
    border-radius: 16px;
    border: none;
    box-shadow: 0 4px 15px rgba(0,0,0,.03);
    padding: 20px;
    height: 100%;
    border-left: 5px solid var(--tq);
}
.analytics-card-navy { border-left-color: var(--navy); }

/* ── Buttons ───────────────────────────────── */
.btn-turquoise {
    background-color: var(--tq); color: #fff; border: none;
    border-radius: 10px; font-size: 14px; font-weight: 500;
    transition: background .18s, transform .15s, box-shadow .18s;
}
.btn-turquoise:hover {
    background-color: var(--tq-dark); color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px var(--tq-glow);
}

/* ── Table ─────────────────────────────────── */
.table thead th {
    border-bottom: 3px solid var(--tq) !important;
    color: #f8f9fa !important; font-weight: 600;
    text-transform: uppercase; font-size: 12px;
    letter-spacing: .08em;
    background-color: var(--navy) !important;
    padding: 16px;
}
.table tbody td {
    vertical-align: middle; color: #2d3748;
    padding: 13px 16px;
    border-bottom: 1px solid rgba(0,0,0,.05);
}
.table tbody tr { transition: background .15s; }
.table tbody tr:hover { background: rgba(2,206,203,.04); }

/* ── Pagination ────────────────────────────── */
.page-item.active .page-link {
    background-color: var(--tq); border-color: var(--tq); color: #fff;
}
.page-link { color: var(--tq); }

/* ── Variance Badges ───────────────────────── */
.variance-positive { color: #065f46; font-weight: 600; }
.variance-negative { color: #991b1b; font-weight: 600; }

/* ── Chart Card ────────────────────────────── */
.chart-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,.06);
    box-shadow: 0 4px 15px rgba(0,0,0,.03);
    padding: 20px;
}
</style>

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0">Financial Forecasting</h2>
            <p class="text-muted mb-0">Predict and visualize financial trends dynamically across departments.</p>
        </div>
    </div>

    <!-- ═══════════ ECONOMIC INDICATORS ═══════════ -->
    @{
        var econData = ViewBag.EconomicData as FinSight.Models.ViewModels.EconomicDataViewModel;
    }
    @if (econData != null && !econData.HasError)
    {
        <div class="card-dashboard mb-4" style="background: linear-gradient(to right, #ffffff, #f8fafc);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-navy mb-0 ps-1">
                    <i class="bi bi-globe2 me-2 text-turquoise"></i>Macroeconomic Indicators
                </h5>
                <span class="d-flex align-items-center gap-2" style="font-size: 0.75rem; font-weight: 500; color: var(--muted-clr);">
                    <span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block; position: relative;"></span>
                    <span>Live via Alpha Vantage</span>
                </span>
            </div>
            
            <div class="row g-3">
                @foreach (var ind in econData.All)
                {
                    <div class="col-xl-3 col-md-6">
                        <div style="background: #fff; border: 1px solid rgba(0,0,0,0.05); border-radius: 12px; padding: 16px; position: relative; overflow: hidden;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">@ind.Name</span>
                                <i class="bi @ind.Icon fs-5" style="opacity: 0.8; color: var(--tq);"></i>
                            </div>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="fw-bold text-navy mb-0" style="font-family: 'Inter', monospace;">
                                    @ind.LatestValue?.ToString("N2")<span style="font-size: 1rem; color: #6b7280; font-weight: 600; margin-left: 2px;">@ind.Unit</span>
                                </h3>
                                
                                @if (ind.Trend == "up")
                                {
                                    <span style="color: #10b981; font-size: 0.75rem; font-weight: 600; background: rgba(16,185,129,0.1); padding: 2px 6px; border-radius: 4px;">
                                        <i class="bi bi-arrow-up-right me-1"></i>@ind.Change?.ToString("N2")
                                    </span>
                                }
                                else if (ind.Trend == "down")
                                {
                                    <span style="color: #ef4444; font-size: 0.75rem; font-weight: 600; background: rgba(239,68,68,0.1); padding: 2px 6px; border-radius: 4px;">
                                        <i class="bi bi-arrow-down-right me-1"></i>@ind.Change?.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #6b7280; font-size: 0.75rem; font-weight: 600; background: rgba(107,114,128,0.1); padding: 2px 6px; border-radius: 4px;">
                                        <i class="bi bi-dash me-1"></i>0.00
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ═══════════ ANALYTICS DASHBOARD ═══════════ -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="analytics-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: .05em; color: #6c757d;">Budgets Tracked</h6>
                        <h3 class="fw-bold text-navy mb-0">@(ViewBag.TotalForecasts ?? 0)</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: var(--tq-light); width: 48px; height: 48px;">
                        <i class="bi bi-list-check text-turquoise fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="analytics-card analytics-card-navy">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: .05em; color: #6c757d;">Projected Expenses</h6>
                        <h3 class="fw-bold text-navy mb-0">₱@(((decimal)(ViewBag.TotalProjectedExpenses ?? 0m)).ToString("N0"))</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(22,34,41,.08); width: 48px; height: 48px;">
                        <i class="bi bi-cash-stack text-navy fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="analytics-card" style="border-left-color: #f59e0b;">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: .05em; color: #6c757d;">Applied Inflation</h6>
                        <h3 class="fw-bold text-navy mb-0">@(((decimal)(ViewBag.AppliedInflationRate ?? 0m) * 100).ToString("N2"))%</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(245,158,11,.08); width: 48px; height: 48px;">
                        <i class="bi bi-graph-up-arrow fs-5" style="color: #f59e0b;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="analytics-card" style="border-left-color: var(--danger);">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: .05em; color: #6c757d;">Projected Net Variance</h6>
                        <h3 class="fw-bold @(((decimal)(ViewBag.TotalProjectedVariance ?? 0m)) >= 0 ? "variance-positive" : "variance-negative") mb-0">
                            ₱@(((decimal)(ViewBag.TotalProjectedVariance ?? 0m)).ToString("N0"))
                        </h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(226,109,92,.08); width: 48px; height: 48px;">
                        <i class="bi bi-activity fs-5" style="color: var(--danger);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════ CHARTS ═══════════ -->
    <div class="chart-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-navy mb-0 ps-1">
                <i class="bi bi-bar-chart-fill me-2 text-turquoise"></i>Budget vs Projected Expenses
            </h5>
        </div>
        <canvas id="barChart" height="90"></canvas>
    </div>

    <!-- ═══════════ DATA TABLE ═══════════ -->
    <div class="card-dashboard mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-navy mb-0 ps-2"><i class="bi bi-table me-2 text-turquoise"></i>Dynamic Forecasts</h5>
            
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                <select name="yearFilter" class="form-select border-0 bg-offwhite shadow-sm rounded-3 fw-medium" style="width: auto; cursor: pointer;">
                    <option value="">All Years</option>
                    @if (ViewBag.YearList != null)
                    {
                        foreach (var y in (List<SelectListItem>)ViewBag.YearList)
                        {
                            <option value="@y.Value" selected="@(ViewBag.CurrentYear?.ToString() == y.Value ? "selected" : null)">@y.Text</option>
                        }
                    }
                </select>

                <select name="departmentFilter" class="form-select border-0 bg-offwhite shadow-sm rounded-3 fw-medium" style="width: auto; cursor: pointer;">
                    <option value="">All Departments</option>
                    @if (ViewBag.DepartmentList != null)
                    {
                        foreach (var d in (List<SelectListItem>)ViewBag.DepartmentList)
                        {
                            <option value="@d.Value" selected="@(ViewBag.CurrentDepartment?.ToString() == d.Value ? "selected" : null)">@d.Text</option>
                        }
                    }
                </select>

                <div class="input-group shadow-sm bg-offwhite rounded-3 border-0 overflow-hidden" style="width: 250px;">
                    <span class="input-group-text border-0 bg-transparent text-turquoise"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-0 shadow-none bg-transparent" placeholder="Search..." />
                </div>
                
                <button type="submit" class="btn btn-turquoise rounded-3 px-3 shadow-sm fw-semibold">Filter</button>
                
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || ViewBag.CurrentYear != null || ViewBag.CurrentDepartment != null)
                {
                    <a asp-action="Index" class="btn btn-light rounded-3 shadow-sm" style="color: var(--danger);"><i class="bi bi-x-circle"></i></a>
                }
            </form>
        </div>

        <div class="table-responsive rounded-3">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Department</th>
                        <th>Category</th>
                        <th>Budget Amount</th>
                        <th>Current Expenses</th>
                        <th>Run Rate</th>
                        <th>Projected Total Exp.</th>
                        <th>Future Util.</th>
                        <th>Projected Variance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-turquoise">@item.DepartmentName</td>
                                <td class="fw-semibold">@item.Category</td>
                                <td>₱@item.BudgetAmount.ToString("N0")</td>
                                <td class="text-muted">₱@item.CurrentExpenses.ToString("N0")</td>
                                <td>₱@item.RunRate.ToString("N0")</td>
                                <td class="fw-bold">₱@item.FutureExpenses.ToString("N0")</td>
                                <td class="fw-bold">@item.FutureBudgetUtilization.ToString("N1")%</td>
                                <td class="@(item.PredictedVariance >= 0 ? "variance-positive" : "variance-negative")">
                                    @(item.PredictedVariance >= 0 ? "+" : "")₱@item.PredictedVariance.ToString("N0")
                                </td>
                                <td>
                                    @if (item.Status.Contains("Under Budget"))
                                    {
                                        <span style="color: #065f46; font-size: 0.75rem; font-weight: 600; background: #d1fae5; padding: 4px 10px; border-radius: 20px;">
                                            <i class="bi bi-graph-down-arrow me-1"></i>Under
                                        </span>
                                    }
                                    else if (item.Status.Contains("Over Budget"))
                                    {
                                        <span style="color: #991b1b; font-size: 0.75rem; font-weight: 600; background: #fee2e2; padding: 4px 10px; border-radius: 20px;">
                                            <i class="bi bi-exclamation-circle me-1"></i>Over
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: #1e40af; font-size: 0.75rem; font-weight: 600; background: #dbeafe; padding: 4px 10px; border-radius: 20px;">
                                            <i class="bi bi-check-circle me-1"></i>Track
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-bar-graph fs-1 d-block mb-2 opacity-50"></i>
                                No forecasts generated matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="small text-muted fw-medium">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link shadow-sm" asp-action="Index" asp-route-page="@i" 
                               asp-route-searchString="@ViewBag.CurrentSearch" 
                               asp-route-yearFilter="@ViewBag.CurrentYear" 
                               asp-route-departmentFilter="@ViewBag.CurrentDepartment">@i</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const barCtx = document.getElementById('barChart').getContext('2d');
            
            const deptLabels = JSON.parse('@Html.Raw(ViewBag.BarChartLabels)');
            const budgetData = JSON.parse('@Html.Raw(ViewBag.BarChartBudget)');
            const forecastData = JSON.parse('@Html.Raw(ViewBag.BarChartForecast)');

            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: deptLabels,
                    datasets: [
                        {
                            label: 'Budget',
                            data: budgetData,
                            backgroundColor: '#162229',
                            borderRadius: 4
                        },
                        {
                            label: 'Projected Expenses',
                            data: forecastData,
                            backgroundColor: '#05828e',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ₱' + context.raw.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₱' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
