@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestVerificationToken" />
    <title>@ViewData["Title"] - FinSight ERP</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* ── Design Tokens ────────────────────────── */
        :root {
            --bg-main:    #e7eaef;
            --bg-sidebar: #162229;
            --bg-topbar:  #080b11;
            --accent:     #05828e;
            --accent-hover:#047078;
            --muted:      #9ba8b8;
            --text-light: #ffffff;
            --text-body:  #2d3748;
            --card-bg:    #ffffff;
            --sidebar-w:  270px;
        }

        /* ── Reset ────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            background-color: var(--bg-main);
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: var(--text-body);
            overflow-x: hidden;
        }

        /* ── Wrapper ──────────────────────────────── */
        #wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ──────────────────────────────── */
        #sidebar {
            width: var(--sidebar-w);
            min-width: var(--sidebar-w);
            background: var(--bg-sidebar);
            color: var(--text-light);
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1050;
            overflow-y: auto;
            transition: transform 0.3s cubic-bezier(.4,0,.2,1);
            display: flex;
            flex-direction: column;
        }

        #sidebar.collapsed {
            transform: translateX(calc(-1 * var(--sidebar-w)));
        }

        /* Sidebar brand */
        .sidebar-brand {
            padding: 28px 24px 20px;
            border-bottom: 1px solid rgba(155,168,184,0.1);
        }

        .sidebar-brand h4 {
            margin: 0;
            font-weight: 800;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-light);
            letter-spacing: -0.01em;
        }

        .sidebar-brand h4 i {
            color: var(--accent);
            font-size: 1.5rem;
        }

        /* Sidebar nav */
        .sidebar-nav {
            list-style: none;
            padding: 16px 14px;
            margin: 0;
            flex: 1;
        }

        .sidebar-nav li {
            margin-bottom: 4px;
        }

        .sidebar-nav li a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            font-size: 0.925rem;
            font-weight: 500;
            color: var(--muted);
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .sidebar-nav li a i {
            font-size: 1.2rem;
            min-width: 22px;
            text-align: center;
            transition: color 0.2s;
        }

        .sidebar-nav li a:hover {
            background: rgba(5,130,142,0.12);
            color: var(--text-light);
            transform: translateX(3px);
        }

        .sidebar-nav li a:hover i {
            color: var(--accent);
        }

        .sidebar-nav li.active a {
            background: var(--accent);
            color: var(--text-light);
            box-shadow: 0 4px 16px rgba(5,130,142,0.35);
            font-weight: 600;
        }

        .sidebar-nav li.active a i {
            color: var(--text-light);
        }

        /* Logout */
        .sidebar-footer {
            padding: 12px 14px 20px;
            border-top: 1px solid rgba(155,168,184,0.1);
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            color: var(--muted);
            text-decoration: none;
            border-radius: 10px;
            font-size: 0.925rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .sidebar-footer a:hover {
            background: rgba(226,109,92,0.15);
            color: #E26D5C;
        }

        .sidebar-footer a:hover i {
            color: #E26D5C;
        }

        /* ── Main Content Area ────────────────────── */
        #main-content {
            flex: 1;
            margin-left: var(--sidebar-w);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: margin-left 0.3s cubic-bezier(.4,0,.2,1);
        }

        #main-content.expanded {
            margin-left: 0;
        }

        /* ── Topbar ───────────────────────────────── */
        .topbar {
            background: var(--bg-topbar);
            padding: 0 28px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1040;
            box-shadow: 0 2px 12px rgba(0,0,0,0.12);
        }

        .topbar-toggle {
            background: transparent;
            border: 1.5px solid rgba(155,168,184,0.25);
            color: var(--muted);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .topbar-toggle:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(5,130,142,0.08);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* ── Notification Dropdown ── */
        .notification-dropdown {
            position: relative;
        }
        .notification-btn {
            background: none;
            border: none;
            color: var(--muted);
            position: relative;
            cursor: pointer;
            transition: color 0.2s;
            padding: 5px;
        }
        .notification-btn:hover, .notification-btn.active {
            color: var(--accent);
        }
        .notification-btn .badge-count {
            position: absolute;
            top: 0;
            right: 0;
            background: #e74c3c;
            color: white;
            font-size: 0.6rem;
            font-weight: bold;
            width: 18px;
            height: 18px;
            line-height: 18px;
            text-align: center;
            padding: 0;
            border-radius: 50%;
            display: none;
            transform: translate(25%, -25%);
        }
        .notification-panel {
            position: absolute;
            top: 100%;
            right: -10px;
            margin-top: 15px;
            width: 320px;
            background: var(--card-bg);
            border: 1px solid rgba(155, 168, 184, 0.1);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: none;
            flex-direction: column;
            z-index: 1000;
        }
        .notification-panel.show {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        .notification-header {
            padding: 15px 20px;
            border-bottom: 1px solid rgba(155, 168, 184, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .notification-header h6 {
            margin: 0;
            font-weight: 600;
            color: var(--text-body);
        }
        .mark-all-read {
            font-size: 0.75rem;
            color: var(--accent);
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
        }
        .mark-all-read:hover {
            text-decoration: underline;
        }
        .notification-body {
            max-height: 350px;
            overflow-y: auto;
            padding: 0;
            margin: 0;
            list-style: none;
        }
        .notification-item {
            padding: 15px 20px;
            border-bottom: 1px solid rgba(155, 168, 184, 0.05);
            display: flex;
            gap: 12px;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
            color: var(--text-body);
        }
        .notification-item:hover {
            background: rgba(155, 168, 184, 0.05);
            color: var(--text-body);
        }
        .notification-item.unread {
            background: rgba(5, 130, 142, 0.05);
        }
        .notification-item.unread::before {
            content: '';
            position: absolute;
            left: 5px;
            margin-top: 5px;
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
        }
        .notification-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.1rem;
        }
        .icon-system { background: rgba(5,130,142,0.1); color: var(--accent); }
        .icon-approval { background: rgba(243,156,18,0.1); color: #f39c12; }
        .icon-payment { background: rgba(46,204,113,0.1); color: #2ecc71; }
        .icon-subscription { background: rgba(155,89,182,0.1); color: #9b59b6; }
        .icon-security { background: rgba(231,76,60,0.1); color: #e74c3c; }
        
        .notification-content {
            flex-grow: 1;
            min-width: 0;
        }
        .notification-title {
            font-size: 0.85rem;
            font-weight: 600;
            margin: 0 0 3px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .notification-message {
            font-size: 0.75rem;
            color: var(--muted);
            margin: 0 0 5px 0;
            line-height: 1.3;
        }
        .notification-time {
            font-size: 0.65rem;
            color: var(--muted);
            margin: 0;
        }
        .notification-empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--muted);
        }
        .notification-empty i {
            font-size: 2rem;
            margin-bottom: 10px;
            display: block;
            opacity: 0.5;
        }

        .profile-dropdown {
            position: relative;
        }
        .profile-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 16px 5px 6px;
            border: 1.5px solid rgba(155,168,184,0.2);
            border-radius: 50px;
            background: transparent;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            color: inherit;
        }

        .profile-btn:hover {
            border-color: var(--accent);
            background: rgba(5,130,142,0.06);
        }

        .profile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            font-weight: 700;
            font-size: 0.8rem;
        }

        .profile-info {
            text-align: left;
        }

        .profile-info .name {
            font-size: 0.825rem;
            font-weight: 600;
            color: var(--text-light);
            line-height: 1.2;
        }

        .profile-info .role {
            font-size: 0.7rem;
            color: var(--muted);
            line-height: 1.2;
        }

        /* ── Page Body ────────────────────────────── */
        .page-body {
            flex: 1;
            padding: 28px;
        }

        /* ── Overlay (mobile) ─────────────────────── */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(8,11,17,0.55);
            z-index: 1045;
            backdrop-filter: blur(2px);
        }

        .sidebar-overlay.show {
            display: block;
        }

        /* ── Responsive ───────────────────────────── */
        @@media (max-width: 991.98px) {
            #sidebar {
                transform: translateX(calc(-1 * var(--sidebar-w)));
            }

            #sidebar.mobile-open {
                transform: translateX(0);
            }

            #main-content {
                margin-left: 0;
            }
        }

        /* ── Dropdown Overrides ────────────────────── */
        .dropdown-menu {
            border: 1px solid rgba(155,168,184,0.15);
            border-radius: 12px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.15);
            padding: 6px;
            overflow: hidden;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 9px 14px;
            font-size: 0.875rem;
            transition: background 0.15s;
        }

        .dropdown-item:hover {
            background: rgba(5,130,142,0.08);
        }

        /* ── Scrollbar ────────────────────────────── */
        #sidebar::-webkit-scrollbar {
            width: 4px;
        }

        #sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: rgba(155,168,184,0.2);
            border-radius: 10px;
        }

        /* ── Sidebar Submenu ──────────────────────── */
        .sidebar-nav .nav-submenu-toggle {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            font-size: 0.925rem;
            font-weight: 500;
            color: var(--muted);
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }
        .sidebar-nav .nav-submenu-toggle:hover {
            background: rgba(5,130,142,0.12);
            color: var(--text-light);
        }
        .sidebar-nav .nav-submenu-toggle:hover i {
            color: var(--accent);
        }
        .sidebar-nav .nav-submenu-toggle i.toggle-arrow {
            margin-left: auto;
            font-size: 0.7rem;
            transition: transform 0.25s ease;
        }
        .sidebar-nav .nav-submenu-toggle.open i.toggle-arrow {
            transform: rotate(90deg);
        }
        .sidebar-nav .nav-submenu-toggle.parent-active {
            color: var(--text-light);
        }
        .sidebar-nav .nav-submenu-toggle.parent-active i:first-child {
            color: var(--accent);
        }
        .sidebar-nav .submenu {
            list-style: none;
            padding: 2px 0 4px 0;
            margin: 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .sidebar-nav .submenu.open {
            max-height: 200px;
        }
        .sidebar-nav .submenu li a {
            padding: 9px 16px 9px 52px;
            font-size: 0.85rem;
            color: var(--muted);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .sidebar-nav .submenu li a:hover {
            background: rgba(5,130,142,0.10);
            color: var(--text-light);
            transform: translateX(3px);
        }
        .sidebar-nav .submenu li a i {
            font-size: 1rem;
            min-width: 18px;
            text-align: center;
        }
        .sidebar-nav .submenu li.active a {
            background: var(--accent);
            color: var(--text-light);
            box-shadow: 0 3px 12px rgba(5,130,142,0.30);
            font-weight: 600;
        }
        .sidebar-nav .submenu li.active a i {
            color: var(--text-light);
        }

        /* ── Sidebar Section Titles ───────────────── */
        .sidebar-nav .nav-section-title {
            padding: 18px 16px 6px 16px;
            font-size: 0.65rem;
            font-weight: 700;
            color: rgba(155, 168, 184, 0.6);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <!-- Mobile Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div id="wrapper">

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <nav id="sidebar">
            <div class="sidebar-brand mb-2 d-flex align-items-center">
                <img src="~/images/logo.png" alt="FinSight Logo" style="height: 40px; width: auto; max-width: 100%; object-fit: contain;" />
            </div>

            @{
                var roleId = Context.Session.GetInt32("RoleID") ?? 1;
            }
            <ul class="sidebar-nav">
                <li class="nav-section-title">Main</li>
                <li class="active">
                    <a asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-fill"></i> Dashboard
                    </a>
                </li>
                
                <li class="nav-section-title">Finance & Planning</li>
                @* Budget Allocation: All roles can view *@
                <li>
                    <a asp-controller="BudgetAllocation" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Budget Allocation
                    </a>
                </li>
                @* Actual Expenses: All roles can view *@
                <li>
                    <a asp-controller="Expenses" asp-action="Index">
                        <i class="bi bi-receipt"></i> Actual Expenses
                    </a>
                </li>
                @* Financial Forecasting: Finance Manager, Admin, SuperAdmin only *@
                @if (roleId == 0 || roleId == 1 || roleId == 2)
                {
                    <li>
                        <a asp-controller="Forecast" asp-action="Index">
                            <i class="bi bi-bar-chart-line-fill"></i> Financial Forecasting
                        </a>
                    </li>
                }
                @* Scenario Planning: SuperAdmin, Admin, Finance Manager, Department Head *@
                @if (roleId == 0 || roleId == 1 || roleId == 2 || roleId == 3)
                {
                    <li>
                        <a asp-controller="Scenario" asp-action="Planning">
                            <i class="bi bi-diagram-3-fill"></i> Scenario Planning
                        </a>
                    </li>
                }
                @* Variance Analysis: Finance Manager, Admin, SuperAdmin only *@
                @if (roleId == 0 || roleId == 1 || roleId == 2)
                {
                    <li>
                        <a asp-controller="Variance" asp-action="Analysis">
                            <i class="bi bi-clipboard2-data-fill"></i> Variance Analysis
                        </a>
                    </li>
                }

                <li class="nav-section-title">Operations</li>
                @* Approval Workflow: All roles can view *@
                <li>
                    <a asp-controller="Workflow" asp-action="Approval">
                        <i class="bi bi-shield-check"></i> Approval Workflow
                    </a>
                </li>

                @* User Management: Super Admin and Admin only *@
                @if (roleId == 0 || roleId == 1)
                {
                    <li class="nav-section-title">System & Security</li>
                    <li>
                        <a asp-controller="User" asp-action="Index">
                            <i class="bi bi-people-fill"></i> User Management
                        </a>
                    </li>
                    <li>
                        @{
                            var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                            var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                            bool isAuditSection = (currentCtrl == "User") && (currentAct == "SystemLogs" || currentAct == "SecurityLogs");
                        }
                        <button class="nav-submenu-toggle @(isAuditSection ? "parent-active open" : "")" onclick="toggleSubmenu(this)">
                            <i class="bi bi-shield-check"></i> Audit Logs
                            <i class="bi bi-chevron-right toggle-arrow"></i>
                        </button>
                        <ul class="submenu @(isAuditSection ? "open" : "")">
                            <li class="@(currentAct == "SystemLogs" ? "active" : "")">
                                <a asp-controller="User" asp-action="SystemLogs">
                                    <i class="bi bi-gear"></i> System Logs
                                </a>
                            </li>
                            <li class="@(currentAct == "SecurityLogs" ? "active" : "")">
                                <a asp-controller="User" asp-action="SecurityLogs">
                                    <i class="bi bi-shield-lock"></i> Security Logs
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </a>
            </div>
        </nav>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <div id="main-content">

            <!-- Topbar -->
            <div class="topbar">
                <button type="button" class="topbar-toggle" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <div class="topbar-right">
                    <!-- Notification Dropdown -->
                    <div class="notification-dropdown">
                        <button class="notification-btn" id="notificationBtn" title="Notifications">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="badge-count" id="notificationBadge">0</span>
                        </button>
                        
                        <div class="notification-panel" id="notificationPanel">
                            <div class="notification-header">
                                <h6>Notifications</h6>
                                <button class="mark-all-read" onclick="markAllAsRead()">Mark all as read</button>
                            </div>
                            <ul class="notification-body" id="notificationList">
                                <!-- Populated via AJAX -->
                            </ul>
                        </div>
                    </div>

                    <!-- Profile dropdown -->
                    <div class="dropdown">
                        <button class="profile-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @{
                                var fullName = Context.Session.GetString("FullName") ?? "Admin User";
                                var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
                            }
                            <div class="profile-avatar">@initials</div>
                            <div class="profile-info">
                                <div class="name">@fullName</div>
                                <div class="role">@(Context.Session.GetString("RoleName") ?? "Admin")</div>
                            </div>
                            <i class="bi bi-chevron-down text-muted ms-1" style="font-size:.7rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end mt-2">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2 text-muted"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2 text-muted"></i>Settings</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout" style="color:#E26D5C;"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <main class="page-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Active state based on current URL
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll('.sidebar-nav li');

            links.forEach(li => {
                const a = li.querySelector('a');
                if (a) {
                    const href = a.getAttribute('href');
                    if (href && currentPath.startsWith(href.toLowerCase()) && href !== '/') {
                        links.forEach(item => item.classList.remove('active'));
                        li.classList.add('active');
                    } else if (href === '/' && (currentPath === '/' || currentPath === '/dashboard')) {
                        links.forEach(item => item.classList.remove('active'));
                        li.classList.add('active');
                    }
                }
            });
        });
        
        // Sidebar mobile toggle
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.add('active');
            document.getElementById('sidebarOverlay').classList.add('active');
        });

        document.getElementById('sidebarOverlay').addEventListener('click', function () {
            document.getElementById('sidebar').classList.remove('active');
            document.getElementById('sidebarOverlay').classList.remove('active');
        });

        function toggleSubmenu(btn) {
            btn.classList.toggle('open');
            var submenu = btn.nextElementSibling;
            submenu.classList.toggle('open');
        }

        // Notification System
        let notifBtn, notifPanel, notifBadge, notifList;

        document.addEventListener('DOMContentLoaded', function () {
            notifBtn = document.getElementById('notificationBtn');
            notifPanel = document.getElementById('notificationPanel');
            notifBadge = document.getElementById('notificationBadge');
            notifList = document.getElementById('notificationList');

            if (notifBtn && notifPanel) {
                notifBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    notifPanel.classList.toggle('show');
                    if (notifPanel.classList.contains('show')) {
                        fetchNotifications();
                    }
                });

                document.addEventListener('click', (e) => {
                    if (!notifBtn.contains(e.target) && !notifPanel.contains(e.target)) {
                        notifPanel.classList.remove('show');
                    }
                });
            }
        });

        async function fetchUnreadCount() {
            try {
                const res = await fetch('/api/notification/unread-count');
                if (res.ok) {
                    const data = await res.json();
                    if (data.count > 0) {
                        notifBadge.textContent = data.count > 99 ? '99+' : data.count;
                        notifBadge.style.display = 'block';
                    } else {
                        notifBadge.style.display = 'none';
                    }
                }
            } catch(e) { console.error("Error fetching notification count", e); }
        }

        function getIconClass(type) {
            switch(type.toLowerCase()) {
                case 'approval': return 'bi-shield-check icon-approval';
                case 'payment': return 'bi-wallet2 icon-payment';
                case 'subscription': return 'bi-card-checklist icon-subscription';
                case 'security': return 'bi-shield-lock icon-security';
                default: return 'bi-info-circle icon-system';
            }
        }

        function authenticatedPostOptions() {
            const token = document.querySelector('meta[name="request-verification-token"]')?.content;
            return {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token || ''
                }
            };
        }

        async function fetchNotifications() {
            try {
                const res = await fetch('/api/notification/list');
                if (res.ok) {
                    const data = await res.json();
                    notifList.innerHTML = '';
                    
                    if (data.length === 0) {
                        notifList.innerHTML = `
                            <div class="notification-empty">
                                <i class="bi bi-bell-slash"></i>
                                <p class="mb-0">No notifications yet.</p>
                            </div>
                        `;
                        return;
                    }

                    data.forEach(n => {
                        const li = document.createElement('li');
                        const url = n.url ? n.url : 'javascript:void(0)';
                        li.innerHTML = `
                            <a href="${url}" class="notification-item ${n.isRead ? '' : 'unread'}" onclick="markAsRead(${n.id}, event)">
                                <div class="notification-icon ${getIconClass(n.type).split(' ')[1]}">
                                    <i class="bi ${getIconClass(n.type).split(' ')[0]}"></i>
                                </div>
                                <div class="notification-content">
                                    <h6 class="notification-title">${n.title}</h6>
                                    <p class="notification-message">${n.message}</p>
                                    <p class="notification-time">${n.date}</p>
                                </div>
                            </a>
                        `;
                        notifList.appendChild(li);
                    });
                }
            } catch(e) { console.error("Error fetching notifications", e); }
        }

        async function markAsRead(id, e) {
            try {
                await fetch(`/api/notification/mark-read/${id}`, authenticatedPostOptions());
                fetchUnreadCount();
                // We let the default action (navigation) proceed if it's a real URL
            } catch(e) { console.error("Error marking as read", e); }
        }

        async function markAllAsRead() {
            try {
                await fetch(`/api/notification/mark-all-read`, authenticatedPostOptions());
                fetchUnreadCount();
                fetchNotifications();
            } catch(e) { console.error("Error marking all as read", e); }
        }

        // Poll every 60 seconds
        setInterval(fetchUnreadCount, 60000);
        // Initial load
        fetchUnreadCount();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
