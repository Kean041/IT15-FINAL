@model IEnumerable<FinSight.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
    var roleId = (int)(ViewBag.RoleID ?? 3);
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var totalExpenses = (decimal)(ViewBag.TotalExpenses ?? 0m);
    var monthlyExpenses = (decimal)(ViewBag.MonthlyExpenses ?? 0m);
    var remainingBudget = (decimal)(ViewBag.RemainingBudget ?? 0m);
    var totalAllocated = (decimal)(ViewBag.TotalAllocated ?? 0m);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var utilizationPct = totalAllocated > 0 ? Math.Round((totalExpenses / totalAllocated) * 100, 1) : 0;

    var barColor = "#05828e";
    if (utilizationPct > 90) barColor = "#e74c3c";
    else if (utilizationPct > 70) barColor = "#f39c12";
}

<style>
    .kpi-card {
        background: var(--card-bg, #fff);
        border: none;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        position: relative;
        overflow: hidden;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.10);
    }
    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }
    .kpi-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted, #9ba8b8);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
    }
    .kpi-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-body, #2d3748);
        line-height: 1.2;
    }
    .kpi-sub {
        font-size: 0.75rem;
        color: var(--muted, #9ba8b8);
        margin-top: 2px;
    }
    .expense-table th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted, #9ba8b8);
        font-weight: 600;
        border-bottom: 2px solid #e7eaef;
        padding: 12px 16px;
    }
    .expense-table td {
        padding: 14px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f2f5;
    }
    .expense-table tbody tr:hover {
        background: rgba(5,130,142,0.03);
    }
    .status-badge {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .status-recorded { background: rgba(155,168,184,0.15); color: #6b7a8d; }
    .status-verified { background: rgba(5,130,142,0.12); color: #05828e; }
    .status-archived { background: rgba(22,34,41,0.10); color: #162229; }
    .filter-card {
        background: var(--card-bg, #fff);
        border: none;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .utilization-bar {
        height: 6px;
        border-radius: 3px;
        background: #e7eaef;
        overflow: hidden;
        margin-top: 8px;
    }
    .utilization-bar .fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.6s ease;
    }
</style>

<!-- ── Page Header ── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="letter-spacing: -0.02em;">Expense Management</h2>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Track and manage actual organizational spending.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn d-flex align-items-center gap-2 text-white px-4 py-2" style="background: #05828e; border-radius: 12px; font-weight: 600; border: none; box-shadow: 0 4px 14px rgba(5,130,142,0.3); transition: all 0.2s;">
            <i class="bi bi-plus-lg"></i> Record Expense
        </a>
    }
</div>

<!-- ── KPI Cards ── -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Total Expenses</div>
                    <div class="kpi-value">₱@totalExpenses.ToString("N0")</div>
                    <div class="kpi-sub">@totalCount records</div>
                </div>
                <div class="kpi-icon" style="background: rgba(5,130,142,0.1); color: #05828e;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Remaining Budget</div>
                    <div class="kpi-value" style="color: @(remainingBudget >= 0 ? "#05828e" : "#e74c3c");">₱@remainingBudget.ToString("N0")</div>
                    <div class="kpi-sub">of ₱@totalAllocated.ToString("N0") allocated</div>
                </div>
                <div class="kpi-icon" style="background: rgba(46,204,113,0.1); color: #2ecc71;">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="utilization-bar">
                <div class="fill" style="width: @Math.Min(utilizationPct, 100)%; background: @barColor;"></div>
            </div>
            <div class="kpi-sub mt-1">@utilizationPct% utilized</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Monthly Expenses</div>
                    <div class="kpi-value">₱@monthlyExpenses.ToString("N0")</div>
                    <div class="kpi-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
                </div>
                <div class="kpi-icon" style="background: rgba(155,89,182,0.1); color: #9b59b6;">
                    <i class="bi bi-calendar3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Budget Variance</div>
                    @{
                        var variance = totalAllocated - totalExpenses;
                    }
                    <div class="kpi-value" style="color: @(variance >= 0 ? "#2ecc71" : "#e74c3c");">
                        @(variance >= 0 ? "+" : "")₱@variance.ToString("N0")
                    </div>
                    <div class="kpi-sub">@(variance >= 0 ? "Under budget" : "Over budget")</div>
                </div>
                <div class="kpi-icon" style="background: rgba(243,156,18,0.1); color: #f39c12;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Success/Error messages ── -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── Filters ── -->
<div class="filter-card mb-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted" style="font-size: 0.78rem; font-weight: 600;">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Title, category or description..." value="@ViewBag.CurrentSearch" />
            </div>
            @if (roleId != 3)
            {
                <div class="col-md-2">
                    <label class="form-label text-muted" style="font-size: 0.78rem; font-weight: 600;">Department</label>
                    <select name="departmentId" class="form-select form-select-sm" asp-items="ViewBag.Departments">
                        <option value="">All Departments</option>
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label text-muted" style="font-size: 0.78rem; font-weight: 600;">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="" selected="@(ViewBag.CurrentStatus == null)">All Statuses</option>
                    <option value="Recorded" selected="@(ViewBag.CurrentStatus == "Recorded")">Recorded</option>
                    <option value="Verified" selected="@(ViewBag.CurrentStatus == "Verified")">Verified</option>
                    <option value="Archived" selected="@(ViewBag.CurrentStatus == "Archived")">Archived</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted" style="font-size: 0.78rem; font-weight: 600;">Start Date</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.CurrentStartDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted" style="font-size: 0.78rem; font-weight: 600;">End Date</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewBag.CurrentEndDate" />
            </div>
            <div class="col-md-1 d-flex gap-2">
                <button type="submit" class="btn btn-sm px-3 text-white" style="background: #05828e; border-radius: 8px; border: none;">
                    <i class="bi bi-funnel"></i>
                </button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px;">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ── Data Table ── -->
<div class="filter-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table expense-table mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Department</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox text-muted d-block mb-2" style="font-size: 2rem; opacity: 0.4;"></i>
                                <span class="text-muted">No expenses found.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@item.ExpenseDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.ExpenseTitle</div>
                                    @if (item.BudgetRequestID.HasValue)
                                    {
                                        <small class="text-muted"><i class="bi bi-link-45deg"></i> Request #@item.BudgetRequestID</small>
                                    }
                                </td>
                                <td>@item.Category</td>
                                <td>
                                    <span class="d-flex align-items-center gap-1">
                                        <i class="bi bi-building text-muted" style="font-size: 0.85rem;"></i>
                                        @item.Department?.DepartmentName
                                    </span>
                                </td>
                                <td class="fw-bold">₱@item.Amount.ToString("N2")</td>
                                <td>
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            "Recorded" => "status-recorded",
                                            "Verified" => "status-verified",
                                            "Archived" => "status-archived",
                                            _ => "status-recorded"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@item.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (canManage && item.Status != "Archived")
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ExpenseID" class="btn btn-sm btn-light border" style="border-radius: 8px;" title="Edit">
                                                <i class="bi bi-pencil text-primary"></i>
                                            </a>
                                            @if (item.Status == "Recorded")
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ExpenseID" />
                                                    <input type="hidden" name="newStatus" value="Verified" />
                                                    <button type="submit" class="btn btn-sm btn-light border" style="border-radius: 8px;" title="Mark Verified">
                                                        <i class="bi bi-check-circle text-success"></i>
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn btn-sm btn-light border" style="border-radius: 8px;" title="Archive"
                                                    onclick="openArchiveModal(@item.ExpenseID, '@item.ExpenseTitle.Replace("'", "\\'")')">
                                                <i class="bi bi-archive text-secondary"></i>
                                            </button>
                                        }
                                        @if (canManage && item.Status == "Archived")
                                        {
                                            <button type="button" class="btn btn-sm btn-light border" style="border-radius: 8px;" title="Unarchive"
                                                    onclick="openUnarchiveModal(@item.ExpenseID, '@item.ExpenseTitle.Replace("'", "\\'")')">
                                                <i class="bi bi-arrow-counterclockwise text-primary"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ── Pagination ── -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-4 border-top">
                <span class="text-muted" style="font-size: 0.82rem;">
                    Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&departmentId=@ViewBag.CurrentDepartment&status=@ViewBag.CurrentStatus&startDate=@ViewBag.CurrentStartDate&endDate=@ViewBag.CurrentEndDate&search=@ViewBag.CurrentSearch"
                                   style="@(i == ViewBag.CurrentPage ? "background: #05828e; border-color: #05828e;" : "")">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- ARCHIVE CONFIRMATION MODAL -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-archive" style="font-size:3.5rem;color:#f39c12;"></i>
                <h5 class="fw-bold mt-3 mb-2" style="color:#162229;">Archive Expense</h5>
                <p class="text-muted small mb-4">Are you sure you want to archive <strong id="archiveExpenseName"></strong>? Archived expenses cannot be edited.</p>
                <form id="archiveForm" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="archiveExpenseId" />
                    <input type="hidden" name="newStatus" value="Archived" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-grow-1 fw-medium" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn flex-grow-1 fw-medium text-white" style="background:#f39c12;border:none;border-radius:10px;">
                            <i class="bi bi-archive me-1"></i> Archive
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- UNARCHIVE CONFIRMATION MODAL -->
<div class="modal fade" id="unarchiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-arrow-counterclockwise" style="font-size:3.5rem;color:#05828e;"></i>
                <h5 class="fw-bold mt-3 mb-2" style="color:#162229;">Unarchive Expense</h5>
                <p class="text-muted small mb-4">Are you sure you want to restore <strong id="unarchiveExpenseName"></strong>? The expense will be set back to Recorded status.</p>
                <form id="unarchiveForm" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="unarchiveExpenseId" />
                    <input type="hidden" name="newStatus" value="Recorded" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-grow-1 fw-medium" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn flex-grow-1 fw-medium text-white" style="background:#05828e;border:none;border-radius:10px;">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openArchiveModal(expenseId, expenseTitle) {
        document.getElementById('archiveExpenseId').value = expenseId;
        document.getElementById('archiveExpenseName').innerText = expenseTitle;
        var modal = new bootstrap.Modal(document.getElementById('archiveModal'));
        modal.show();
    }

    function openUnarchiveModal(expenseId, expenseTitle) {
        document.getElementById('unarchiveExpenseId').value = expenseId;
        document.getElementById('unarchiveExpenseName').innerText = expenseTitle;
        var modal = new bootstrap.Modal(document.getElementById('unarchiveModal'));
        modal.show();
    }
</script>
