@model FinSight.Models.ViewModels.BudgetAllocationReportViewModel

@{
    ViewData["Title"] = "Budget Allocation Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Budget Allocation</h3>
        <p class="text-muted mb-0">Detailed view of budget distribution across departments for @Model.Year.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 2; i++)
                {
                    <option value="@i" selected="@(i == Model.Year)">@i</option>
                }
            </select>
        </form>
        <a href="@Url.Action("BudgetAllocation", new { year = Model.Year, export = "pdf" })" class="btn btn-sm btn-primary d-flex align-items-center gap-2" style="border-radius:8px;">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="text-muted fw-semibold ps-4">Department</th>
                        <th class="text-muted fw-semibold">Category</th>
                        <th class="text-muted fw-semibold">Amount</th>
                        <th class="text-muted fw-semibold">Status</th>
                        <th class="text-muted fw-semibold pe-4">Date Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Budgets.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No budget allocations found for @Model.Year
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Budgets)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@(item.Department?.DepartmentName ?? "N/A")</td>
                            <td>@item.Category</td>
                            <td class="fw-bold">@item.Amount.ToString("C")</td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                            </td>
                            <td class="pe-4 text-muted small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
