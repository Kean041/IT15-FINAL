@model FinSight.Models.ViewModels.ForecastingReportViewModel

@{
    ViewData["Title"] = "Forecasting Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Financial Forecasting</h3>
        <p class="text-muted mb-0">Projected budget forecasts across departments for @Model.Year.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 5; i++)
                {
                    <option value="@i" selected="@(i == Model.Year)">@i</option>
                }
            </select>
        </form>
        <a href="@Url.Action("Forecasting", new { year = Model.Year, export = "pdf" })" class="btn btn-sm btn-primary d-flex align-items-center gap-2" style="border-radius:8px;">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="text-muted fw-semibold ps-4">Department</th>
                        <th class="text-muted fw-semibold">Forecast Type</th>
                        <th class="text-muted fw-semibold">Predicted Amount</th>
                        <th class="text-muted fw-semibold pe-4">Target Year</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Forecasts.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No forecasts found for @Model.Year
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Forecasts)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@(item.Department?.DepartmentName ?? "N/A")</td>
                            <td>
                                @if (item.ForecastType == "Optimistic Case")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="border-radius:6px;">
                                        <i class="bi bi-graph-up-arrow me-1"></i> @item.ForecastType
                                    </span>
                                }
                                else if (item.ForecastType == "Pessimistic Case")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="border-radius:6px;">
                                        <i class="bi bi-graph-down-arrow me-1"></i> @item.ForecastType
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="border-radius:6px;">
                                        <i class="bi bi-dash me-1"></i> @item.ForecastType
                                    </span>
                                }
                            </td>
                            <td class="fw-bold">@item.PredictedAmount.ToString("C")</td>
                            <td class="pe-4 text-muted">@item.Year</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
