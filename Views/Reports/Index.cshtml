@{
    ViewData["Title"] = "Reports Dashboard";
    var roleId = Context.Session.GetInt32("RoleID");
    var isSuperAdminOrAdmin = roleId == 0 || roleId == 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Reports & Analytics</h3>
        <p class="text-muted mb-0">Generate and export professional financial and operational reports.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Financial Summary -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-pie-chart-fill fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Financial Summary</h5>
                <p class="text-muted small mb-4">Aggregated view of budgets, expenses, and pending requests across departments.</p>
                <a asp-controller="Reports" asp-action="FinancialSummary" class="btn btn-primary w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    <!-- Variance Analysis -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-graph-down-arrow fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Variance Analysis</h5>
                <p class="text-muted small mb-4">Compare budgets, actual spending, and forecasted amounts to identify variances.</p>
                <a asp-controller="Reports" asp-action="VarianceReport" class="btn btn-info text-white w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    <!-- Budget Allocation -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Budget Allocation</h5>
                <p class="text-muted small mb-4">Detailed breakdown of allocated budgets by category and department.</p>
                <a asp-action="BudgetAllocation" class="btn btn-success w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    <!-- Expenses -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Actual Expenses</h5>
                <p class="text-muted small mb-4">Comprehensive history of all recorded expenses and actual spending.</p>
                <a asp-controller="Reports" asp-action="ExpensesReport" class="btn btn-danger w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    <!-- Forecasting -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-bar-chart-line-fill fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Financial Forecasting</h5>
                <p class="text-muted small mb-4">Review predictive models, base cases, optimistic, and pessimistic projections.</p>
                <a asp-action="Forecasting" class="btn btn-warning text-white w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    <!-- Budget Requests -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary rounded-circle" style="width: 60px; height: 60px;">
                        <i class="bi bi-file-earmark-text fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Budget Requests</h5>
                <p class="text-muted small mb-4">Track pending, approved, and rejected supplemental budget requests.</p>
                <a asp-action="BudgetRequests" class="btn btn-secondary w-100 fw-medium" style="border-radius:8px;">View Report</a>
            </div>
        </div>
    </div>

    @if (isSuperAdminOrAdmin)
    {
        <!-- Audit Logs -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-dark bg-opacity-10 text-dark rounded-circle" style="width: 60px; height: 60px;">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Audit Logs</h5>
                    <p class="text-muted small mb-4">System and security activity logs for compliance and monitoring.</p>
                    <a asp-action="AuditLogs" class="btn btn-dark w-100 fw-medium" style="border-radius:8px;">View Report</a>
                </div>
            </div>
        </div>
    }
</div>
