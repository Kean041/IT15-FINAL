@model FinSight.Models.ViewModels.ExpensesReportViewModel

@{
    ViewData["Title"] = "Expenses Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Actual Expenses</h3>
        <p class="text-muted mb-0">Detailed history of actual spending across departments for @Model.Year.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 2; i++)
                {
                    <option value="@i" selected="@(i == Model.Year)">@i</option>
                }
            </select>
        </form>
        <a href="@Url.Action("ExpensesReport", new { year = Model.Year, export = "pdf" })" class="btn btn-sm btn-primary d-flex align-items-center gap-2" style="border-radius:8px;">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius:12px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
            <div class="card-body p-4 text-white d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase tracking-wide mb-1 opacity-75">Total Actual Spending</h6>
                    <h2 class="fw-bold mb-0">@Model.TotalActualSpending.ToString("C")</h2>
                </div>
                <div class="fs-1 opacity-50">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="text-muted fw-semibold ps-4">Date</th>
                        <th class="text-muted fw-semibold">Department</th>
                        <th class="text-muted fw-semibold">Title</th>
                        <th class="text-muted fw-semibold">Budget Category</th>
                        <th class="text-muted fw-semibold">Amount</th>
                        <th class="text-muted fw-semibold pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Expenses.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No expenses found for @Model.Year
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Expenses)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@item.ExpenseDate.ToString("MMM dd, yyyy")</td>
                            <td class="fw-medium text-dark">@(item.Department?.DepartmentName ?? "N/A")</td>
                            <td>@item.ExpenseTitle</td>
                            <td class="text-muted small">@(item.Budget?.Category ?? "N/A")</td>
                            <td class="fw-bold text-danger">@item.Amount.ToString("C")</td>
                            <td class="pe-4">
                                @if (item.Status == "Verified")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                                else if (item.Status == "Archived")
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="border-radius:6px;">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
