@model IEnumerable<FinSight.Models.User>

@{
    ViewData["Title"] = "Archived Users";
}

<style>
/* ── Color tokens ──────────────────────────── */
:root {
    --tq: #05828e;
    --tq-dark: #047078;
    --tq-light: rgba(5, 130, 142, 0.08);
    --tq-glow: rgba(5, 130, 142, 0.18);
    --navy: #162229;
    --danger: #E26D5C;
    --danger-dark: #c95c4d;
    --success: #10b981;
}

/* ── Backgrounds ───────────────────────────── */
.bg-offwhite    { background-color: #e7eaef; }
.bg-turquoise   { background-color: var(--tq) !important; color: #fff; }
.text-turquoise { color: var(--tq) !important; }
.text-navy      { color: var(--navy) !important; }

/* ── Card ──────────────────────────────────── */
.card-dashboard {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 0.2s ease;
}
.card-dashboard:hover {
    box-shadow: 0 8px 24px var(--tq-glow), 0 2px 8px rgba(0, 0, 0, 0.04);
}

/* ── Buttons ───────────────────────────────── */
.btn-turquoise {
    background-color: var(--tq);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: background 0.18s, transform 0.15s, box-shadow 0.18s;
}
.btn-turquoise:hover {
    background-color: var(--tq-dark);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px var(--tq-glow);
}

.btn-outline-turquoise {
    color: var(--tq);
    border: 1.5px solid var(--tq);
    border-radius: 10px;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
}
.btn-outline-turquoise:hover {
    background-color: var(--tq-light);
    color: var(--tq);
    box-shadow: 0 0 0 3px var(--tq-glow);
}

.btn-success-restore {
    background-color: var(--success);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s, transform 0.15s;
}
.btn-success-restore:hover {
    background-color: #059669;
    color: #fff;
    transform: translateY(-1px);
}

/* ── Table ─────────────────────────────────── */
.table thead th {
    border-bottom: 2px solid var(--navy) !important;
    color: #ffffff !important;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.07em;
    background-color: var(--navy) !important;
    padding: 14px 16px;
}
.table tbody td {
    vertical-align: middle;
    color: #2d3748;
    padding: 13px 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
.table tbody tr {
    transition: background 0.15s;
}
.table tbody tr:hover {
    background: rgba(2, 206, 203, 0.04);
}

/* ── Pagination ────────────────────────────── */
.page-item.active .page-link {
    background-color: var(--tq);
    border-color: var(--tq);
    color: white;
}
.page-link {
    color: var(--tq);
}

/* ── Role Badges ───────────────────────────── */
.badge-super-admin { background-color: #ede9fe; color: #5b21b6; border-radius: 20px; padding: 4px 11px; font-size: 12px; font-weight: 500; }
.badge-admin       { background-color: #dbeafe; color: #1e40af; border-radius: 20px; padding: 4px 11px; font-size: 12px; font-weight: 500; }
.badge-finance     { background-color: #d1fae5; color: #065f46; border-radius: 20px; padding: 4px 11px; font-size: 12px; font-weight: 500; }
.badge-dept-head   { background-color: #fef3c7; color: #92400e; border-radius: 20px; padding: 4px 11px; font-size: 12px; font-weight: 500; }
.badge-executive   { background-color: #fce7f3; color: #9d174d; border-radius: 20px; padding: 4px 11px; font-size: 12px; font-weight: 500; }

/* ── User Avatar ───────────────────────────── */
.user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #9ba8b8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
    opacity: 0.7;
}

/* ── Toast notification ────────────────────── */
.toast-notification {
    position: fixed;
    top: 80px;
    right: 28px;
    z-index: 9999;
    min-width: 320px;
    animation: slideInRight 0.4s ease;
}
@@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
}
</style>

@* ─── Toast Messages ─── *@
@if (TempData["Success"] != null)
{
    <div class="toast-notification alert alert-success alert-dismissible fade show shadow-lg border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-notification alert alert-danger alert-dismissible fade show shadow-lg border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-0"><i class="bi bi-archive me-2 text-turquoise"></i>Archived Users</h2>
            <p class="text-muted mb-0">Users who have been deactivated. Restore to re-enable access.</p>
        </div>
        <div>
            <a asp-controller="User" asp-action="Index" class="btn btn-outline-turquoise shadow-sm px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i>Back to Active Users
            </a>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card card-dashboard mb-4 mt-2">

        <!-- Search Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-navy mb-0 ps-2"><i class="bi bi-archive-fill me-2 text-turquoise"></i>Archived Records</h5>

            <form asp-action="Archived" method="get" class="d-flex align-items-center">
                <div class="input-group shadow-sm bg-offwhite rounded-3 border-0 overflow-hidden" style="width: 280px;">
                    <span class="input-group-text border-0 bg-transparent text-turquoise"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-0 shadow-none bg-transparent" placeholder="Search archived users..." />
                </div>
                <button type="submit" class="btn btn-turquoise ms-2 rounded-3 px-3 shadow-sm fw-semibold">Search</button>
                @if (!string.IsNullOrEmpty((string?)ViewBag.CurrentSearch))
                {
                    <a asp-action="Archived" class="btn btn-light ms-2 rounded-3 text-danger shadow-sm"><i class="bi bi-x-circle"></i></a>
                }
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive rounded-top-3">
                <table class="table table-hover mb-0">
                    <thead class="bg-navy text-white">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Department</th>
                            <th>Archived On</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                var initials = string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
                                var roleBadge = user.RoleID switch
                                {
                                    0 => "badge-super-admin",
                                    1 => "badge-admin",
                                    2 => "badge-finance",
                                    3 => "badge-dept-head",
                                    4 => "badge-executive",
                                    _ => "badge-admin"
                                };
                                var roleName = FinSight.Helpers.Roles.GetRoleName(user.RoleID);

                                <tr style="opacity: 0.75;">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-avatar">@initials</div>
                                            <span class="fw-semibold">@user.FullName</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary">@user.Email</td>
                                    <td><span class="badge @roleBadge">@roleName</span></td>
                                    <td class="text-secondary">@(user.Department?.DepartmentName ?? "—")</td>
                                    <td class="text-secondary small">@(user.UpdatedAt?.ToString("MMM dd, yyyy") ?? user.CreatedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-success-restore" title="Restore User"
                                                data-restore-id="@user.UserID"
                                                data-restore-name="@user.FullName"
                                                onclick="openRestoreModal(this)">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-archive fs-1 d-block mb-3 text-turquoise"></i>
                                    No archived users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-white" style="border-radius: 0 0 16px 16px;">
                    <span class="text-muted small fw-medium">Showing Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                    <ul class="pagination pagination-sm mb-0 shadow-sm">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Archived" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════════ RESTORE CONFIRMATION MODAL ═══════════ -->
<div class="modal fade" id="restoreUserModal" tabindex="-1" aria-labelledby="restoreUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
            <div class="modal-header border-0" style="background:#080b11;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                         style="width:38px;height:38px;background:rgba(16,185,129,0.15);">
                        <i class="bi bi-arrow-counterclockwise" style="color:#10b981;"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="restoreUserModalLabel">Restore User</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background:#fff;">
                <p class="text-secondary mb-1">Are you sure you want to restore</p>
                <p class="fw-bold mb-3" id="restoreUserName" style="color:#162229;"></p>
                <div class="alert d-flex align-items-center gap-2 border-0 mb-0 py-2 px-3" style="background:#d1fae5;border-radius:10px;">
                    <i class="bi bi-info-circle-fill" style="color:#065f46;flex-shrink:0;"></i>
                    <span class="small" style="color:#065f46;">This user will regain their access to the system.</span>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0" style="background:#fff;">
                <button type="button" class="btn btn-light fw-semibold shadow-sm" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                <button type="button" class="btn btn-success-restore fw-semibold shadow-sm px-4" id="confirmRestoreBtn" style="border-radius:10px;">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>Restore
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Restore Form (submitted by modal Confirm button) -->
<form id="restoreForm" asp-action="Restore" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="restoreUserId" />
</form>

@section Scripts {
<script>
    // ── Open Restore Confirmation Modal ──
    function openRestoreModal(btn) {
        var userId   = btn.getAttribute('data-restore-id');
        var userName = btn.getAttribute('data-restore-name');

        document.getElementById('restoreUserId').value   = userId;
        document.getElementById('restoreUserName').textContent = '"' + userName + '"';

        var modal = new bootstrap.Modal(document.getElementById('restoreUserModal'));
        modal.show();
    }

    // ── Confirm Restore — submit hidden form ──
    document.getElementById('confirmRestoreBtn').addEventListener('click', function () {
        document.getElementById('restoreForm').submit();
    });

    // ── Auto-dismiss toast after 4s ──
    setTimeout(function () {
        var toasts = document.querySelectorAll('.toast-notification');
        toasts.forEach(function (toast) {
            var alert = bootstrap.Alert.getOrCreateInstance(toast);
            alert.close();
        });
    }, 4000);
</script>
}
