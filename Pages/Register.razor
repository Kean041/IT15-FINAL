@page "/register"

<style>
    /* Scope styles for the register page */
    .auth-bg {
        background-color: #f4f7f6;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 0;
    }

    .auth-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-width: 500px;
        width: 100%;
        background-color: #ffffff;
    }

    .auth-card-header {
        background-color: #00ADB5; /* Turquoise */
        color: #ffffff;
        padding: 2rem 1.5rem;
        text-align: center;
        border-bottom: 4px solid #00ADB5; /* Turquoise Pattern */
    }

    .auth-card-body {
        padding: 2.5rem 2rem;
    }

    .btn-turquoise {
        background-color: #00ADB5;
        color: #ffffff;
        font-weight: 500;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-turquoise:hover {
        background-color: #008F96;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 173, 181, 0.3);
    }

    .form-control:focus {
        border-color: #00ADB5;
        box-shadow: 0 0 0 0.25rem rgba(0, 173, 181, 0.25);
    }
    
    .text-turquoise {
        color: #00ADB5 !important;
    }

    .text-turquoise:hover {
        color: #008F96 !important;
    }

    .password-toggle {
        cursor: pointer;
        color: #6c757d;
        transition: color 0.2s ease;
    }
    
    .password-toggle:hover {
        color: #00ADB5;
    }
    
    /* Password Strength UI */
    .progress-strength {
        height: 6px;
        margin-top: 8px;
        border-radius: 4px;
        background-color: #e9ecef;
    }
</style>

<div class="auth-bg">
    <div class="auth-card">
        <!-- 1. Header Section -->
        <div class="auth-card-header">
            <h3 class="fw-bold mb-2"><i class="bi bi-person-plus-fill me-2" style="color: #00ADB5;"></i>Create an Account</h3>
            <p class="mb-0 text-white-50 small">Register to FinSight ERP</p>
        </div>

        <!-- 2. Form Section -->
        <div class="auth-card-body">
            
            <form>
                <!-- Full Name Field -->
                <div class="mb-3">
                    <label for="nameInput" class="form-label fw-semibold text-secondary small mb-1">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="nameInput" placeholder="John Doe">
                    </div>
                    <!-- Placeholder Validation -->
                    <div class="form-text text-danger d-none small"><i class="bi bi-info-circle me-1"></i>Full Name is required.</div>
                </div>

                <!-- Email Field -->
                <div class="mb-3">
                    <label for="emailInput" class="form-label fw-semibold text-secondary small mb-1">Business Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control border-start-0 ps-0" id="emailInput" placeholder="name@company.com">
                    </div>
                    <!-- Placeholder Validation -->
                    <div class="form-text text-danger d-none small"><i class="bi bi-info-circle me-1"></i>Valid email is required.</div>
                </div>

                <!-- Password Field -->
                <div class="mb-3">
                    <label for="passwordInput" class="form-label fw-semibold text-secondary small mb-1">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                        <input type="@(_showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0 ps-0" id="passwordInput" placeholder="Create a strong password">
                        <span class="input-group-text bg-white password-toggle border-start-0" @onclick="TogglePasswordVisibility">
                            <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </span>
                    </div>
                    
                    <!-- Password Strength Hint (UI Only) -->
                    <div class="progress progress-strength">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="form-text text-muted small mt-1 d-flex justify-content-between">
                        <span>Strength: <span class="text-warning fw-semibold">Medium</span></span>
                        <span>Must be at least 8 characters.</span>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div class="mb-4">
                    <label for="confirmPasswordInput" class="form-label fw-semibold text-secondary small mb-1">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-check"></i></span>
                        <input type="password" class="form-control border-start-0 ps-0" id="confirmPasswordInput" placeholder="Repeat your password">
                    </div>
                    <!-- Confirm Match Message (UI Only) showing matched state -->
                    <div class="form-text text-success small mt-1"><i class="bi bi-check-circle-fill me-1"></i> Passwords match.</div>
                </div>

                <!-- Register Button -->
                <button type="button" class="btn btn-turquoise w-100 py-2 mb-3 shadow-sm">Create Account</button>

                <!-- Login Link -->
                <div class="text-center mt-4">
                    <span class="text-secondary small">Already have an account? </span>
                    <a href="/login" class="fw-bold text-decoration-none text-turquoise small">Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    // UI logic for toggling password visibility
    private bool _showPassword = false;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }
}
