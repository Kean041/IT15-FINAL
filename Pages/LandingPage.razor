@page "/"

<style>
    :root {
        --primary-turquoise: #00ADB5;
        --primary-turquoise-hover: #008F96;
        --text-dark: #222831;
        --bg-light: #EEEEEE;
        --white: #FFFFFF;
    }

    /* Scoped basic font settings if needed, otherwise rely on Bootstrap */
    .landing-page-body {
        background-color: var(--white);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .text-turquoise {
        color: var(--primary-turquoise) !important;
    }

    .bg-turquoise {
        background-color: var(--primary-turquoise) !important;
        color: var(--white);
    }

    .btn-turquoise {
        background-color: var(--primary-turquoise);
        color: var(--white);
        border: none;
    }

    .btn-turquoise:hover {
        background-color: var(--primary-turquoise-hover);
        color: var(--white);
    }

    .btn-outline-turquoise {
        color: var(--primary-turquoise);
        border-color: var(--primary-turquoise);
        background-color: transparent;
    }

    .btn-outline-turquoise:hover {
        background-color: var(--primary-turquoise);
        color: var(--white);
    }

    /* Navbar */
    .lp-navbar {
        box-shadow: 0 2px 4px rgba(0,0,0,.08);
    }
    
    .navbar-brand.lp-brand {
        font-weight: 700;
        font-size: 1.5rem;
    }

    /* Hero Section */
    .hero-section {
        padding: 6rem 0;
        background-color: var(--white);
    }
    
    .hero-illustration {
        height: 400px;
        border: 2px dashed #e2e8f0;
        background-color: #f8fafc;
        border-radius: 12px;
    }

    /* Feature Cards */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #eaeaea;
        border-radius: 8px;
    }

    .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
    }
    
    .feature-icon {
        font-size: 2.5rem;
        color: var(--primary-turquoise);
        margin-bottom: 1rem;
    }

    /* Pricing/Subscription Cards */
    .pricing-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
    }

    .pricing-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    }

    /* About Section */
    .about-section {
        background-color: #f8f9fa;
        padding: 5rem 0;
    }

    /* Footer */
    .lp-footer {
        background-color: var(--text-dark);
        color: var(--white);
    }
    
    .lp-footer a {
        color: #adb5bd;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    
    .lp-footer a:hover {
        color: var(--primary-turquoise);
    }
</style>

<div class="landing-page-body">
    <!-- 1. NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top py-3 lp-navbar">
        <div class="container">
            <a class="navbar-brand lp-brand text-turquoise" href="#">
                <i class="bi bi-bullseye me-2"></i>FinSight
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#lpNavbarNav" aria-controls="lpNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="lpNavbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold active" aria-current="page" href="#">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="#pricing">Pricing</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="#about">About</a>
                    </li>
                </ul>
                <div class="d-flex">
                    <a href="/login" class="btn btn-outline-turquoise me-2 px-4 shadow-sm">Login</a>
                    <button class="btn btn-turquoise px-4 shadow-sm" type="button">Get Started</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- 2. HERO SECTION -->
    <section class="hero-section text-center text-lg-start">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <h1 class="display-4 fw-bold mb-4" style="color: var(--text-dark); line-height: 1.2;">
                        Smart Budget Planning and Forecasting for SMEs
                    </h1>
                    <p class="lead text-muted mb-5" style="font-size: 1.15rem;">
                        Take control of your business finances. FinSight is a responsive, modern ERP system that helps you manage budgets, build accurate forecasts, and make data-driven financial decisions.
                    </p>
                    <div class="d-grid gap-3 d-md-flex justify-content-md-start">
                        <button type="button" class="btn btn-turquoise btn-lg px-4 shadow">Get Started Now</button>
                        <button type="button" class="btn btn-light btn-lg border px-4 shadow-sm">Explore Features</button>
                    </div>
                </div>
                <div class="col-lg-6">
                    <!-- Placeholder Illustration -->
                    <div class="hero-illustration d-flex flex-column align-items-center justify-content-center shadow-sm">
                        <i class="bi bi-graph-up text-turquoise mb-3" style="font-size: 6rem; opacity: 0.8;"></i>
                        <h4 class="text-secondary fw-bold">Dashboard Illustration</h4>
                        <p class="text-muted small">Financial summaries & charts placeholder</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. FEATURES SECTION -->
    <section id="features" class="py-5 bg-white">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold" style="color: var(--text-dark);">Core Features</h2>
                <div class="mx-auto mt-2 mb-3 bg-turquoise" style="height: 3px; width: 60px; border-radius: 2px;"></div>
                <p class="text-muted fs-5">Everything you need to optimize your financial operations</p>
            </div>
            <div class="row g-4">
                <!-- Feature 1 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 feature-card p-4 text-center border-0">
                        <div class="card-body">
                            <i class="bi bi-wallet2 feature-icon"></i>
                            <h5 class="card-title fw-bold">Budget Planning</h5>
                            <p class="card-text text-muted">Create detailed, department-level budgets effortlessly using our intuitive interface.</p>
                        </div>
                    </div>
                </div>
                <!-- Feature 2 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 feature-card p-4 text-center border-0">
                        <div class="card-body">
                            <i class="bi bi-bar-chart-line feature-icon"></i>
                            <h5 class="card-title fw-bold">Financial Forecasting</h5>
                            <p class="card-text text-muted">Project future revenues and expenses based on historical data patterns.</p>
                        </div>
                    </div>
                </div>
                <!-- Feature 3 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 feature-card p-4 text-center border-0">
                        <div class="card-body">
                            <i class="bi bi-pie-chart feature-icon"></i>
                            <h5 class="card-title fw-bold">Variance Analysis</h5>
                            <p class="card-text text-muted">Compare actuals against budgets in real-time to identify critical anomalies.</p>
                        </div>
                    </div>
                </div>
                <!-- Feature 4 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 feature-card p-4 text-center border-0">
                        <div class="card-body">
                            <i class="bi bi-diagram-3 feature-icon"></i>
                            <h5 class="card-title fw-bold">Approval Workflow</h5>
                            <p class="card-text text-muted">Streamline decision-making with automated, role-based financial approvals.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SUBSCRIPTION PLAN SECTION -->
    <section id="pricing" class="py-5" style="background-color: #f8fafc;">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold" style="color: var(--text-dark);">Subscription Plans</h2>
                <div class="mx-auto mt-2 mb-3 bg-turquoise" style="height: 3px; width: 60px; border-radius: 2px;"></div>
                <p class="text-muted fs-5">Transparent pricing designed for growing businesses</p>
            </div>
            
            <div class="row g-4 justify-content-center">
                <!-- Starter Plan -->
                <div class="col-md-6 col-lg-4">
                    <div class="card pricing-card h-100 border-0 p-4">
                        <div class="card-body text-center d-flex flex-column">
                            <h4 class="card-title fw-bold mb-2">Starter</h4>
                            <p class="text-muted small mb-4">Essential tools for small teams</p>
                            <h2 class="fw-bold text-turquoise mb-4">$49<span class="fs-6 text-muted"> / mo</span></h2>
                            
                            <hr class="mb-4">
                            
                            <ul class="list-unstyled text-start mb-4 flex-grow-1">
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Up to 5 Users</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Basic Budgeting</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Standard Reporting</li>
                                <li class="mb-3 text-muted"><i class="bi bi-x-circle me-2"></i> No Variance Analysis</li>
                            </ul>
                            <button class="btn btn-outline-turquoise w-100 py-2 fw-semibold mt-auto mt-3">Choose Starter</button>
                        </div>
                    </div>
                </div>
                <!-- Professional Plan -->
                <div class="col-md-6 col-lg-4">
                    <div class="card pricing-card h-100 border-0 p-4 shadow" style="border-top: 5px solid var(--primary-turquoise) !important;">
                        <div class="card-body text-center d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-turquoise px-3 py-2 rounded-pill small">Most Popular</span>
                            </div>
                            <h4 class="card-title fw-bold mb-2">Professional</h4>
                            <p class="text-muted small mb-3">Comprehensive system for SMEs</p>
                            <h2 class="fw-bold text-turquoise mb-4">$149<span class="fs-6 text-muted"> / mo</span></h2>
                            
                            <hr class="mb-4">
                            
                            <ul class="list-unstyled text-start mb-4 flex-grow-1">
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Up to 25 Users</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Advanced Budgeting & Forecasting</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Variance Analysis</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Custom Approval Workflows</li>
                            </ul>
                            <button class="btn btn-turquoise w-100 py-2 fw-semibold mt-auto shadow-sm">Get Professional</button>
                        </div>
                    </div>
                </div>
                <!-- Enterprise Plan -->
                <div class="col-md-6 col-lg-4">
                    <div class="card pricing-card h-100 border-0 p-4">
                        <div class="card-body text-center d-flex flex-column">
                            <h4 class="card-title fw-bold mb-2">Enterprise</h4>
                            <p class="text-muted small mb-4">Tailored solutions for scale</p>
                            <h2 class="fw-bold text-dark mb-4">Custom</h2>
                            
                            <hr class="mb-4">
                            
                            <ul class="list-unstyled text-start mb-4 flex-grow-1">
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Unlimited Users</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Full System Access</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Dedicated Account Manager</li>
                                <li class="mb-3"><i class="bi bi-check-circle-fill text-turquoise me-2"></i> Custom Integrations</li>
                            </ul>
                            <button class="btn btn-dark w-100 py-2 fw-semibold mt-auto mt-3">Contact Sales</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. ABOUT SECTION -->
    <section id="about" class="about-section text-center">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-4" style="color: var(--text-dark);">About FinSight ERP</h2>
                    <p class="lead text-muted mb-0" style="font-size: 1.15rem; line-height: 1.8;">
                        FinSight ERP is a next-generation financial platform built exclusively to support the growth of Small and Medium Enterprises. 
                        We emphasize <strong>efficiency</strong>, <strong>automation</strong>, and robust <strong>decision-making</strong> capabilities to help discard spreadsheet chaos. 
                        Experience real-time visibility into your business health and steer your enterprise with absolute confidence.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. FOOTER -->
    <footer class="lp-footer py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="fw-bold text-turquoise mb-1">
                        <i class="bi bi-bullseye me-2"></i>FinSight
                    </h5>
                    <small class="text-muted d-block">Smart ERP for Modern SMEs</small>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <small class="text-secondary">&copy; @DateTime.Now.Year FinSight ERP System. All rights reserved.</small>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <a href="#" class="me-3 small">Privacy</a>
                    <a href="#" class="me-3 small">Terms</a>
                    <a href="#" class="small">Contact</a>
                </div>
            </div>
        </div>
    </footer>
</div>

@code {
    // This Blazor component only handles the UI structure and presentation 
    // for the FinSight Landing Page. 
    // Navigation, login logic, and other backend functionalities are intentionally omitted.
}
